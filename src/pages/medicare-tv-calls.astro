<script>
  const calls = document.querySelector<HTMLInputElement>('#med-calls');
  const rate = document.querySelector<HTMLInputElement>('#med-rate');
  const updateEstimate = () => {
    if (!calls || !rate) return;
    const count = Number(calls.value);
    const percent = Number(rate.value);
    const spend = count * 35;
    const applications = count * percent / 100;
    const cpa = spend / applications;
    const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const outputs: Record<string, string> = {
      'med-call-output': String(count),
      'med-rate-output': String(percent) + '%',
      'med-cost-output': usd(spend),
      'med-apps-output': '~' + Math.round(applications),
      'med-cpa-output': '~' + usd(cpa),
    };
    for (const [id, value] of Object.entries(outputs)) {
      const output = document.getElementById(id);
      if (output) output.textContent = value;
    }
  };
  calls?.addEventListener('input', updateEstimate);
  rate?.addEventListener('input', updateEstimate);
  updateEstimate();
</script>
