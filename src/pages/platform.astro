---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHead from '../components/SectionHead.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import CheckList from '../components/CheckList.astro';
import IconBadge from '../components/IconBadge.astro';
import CtaBand from '../components/CtaBand.astro';
import { features } from '../lib/features';
import { loginHref } from '../lib/site';

const also = [
  ['receipt', 'Call log with recordings'],
  ['calendar-clock', 'Delivery hours, states and daily caps'],
  ['phone-forwarded', 'Returns'],
  ['receipt', 'Monthly statements'],
  ['headset', 'Browser softphone for your agents'],
  ['users', 'Password reset and invites for your team'],
] as const;
---

<Base
  title="The Client Portal | Life Leads Plus"
  description="Every Life Leads Plus client gets a portal login for calls, recordings, agents, applications, prepaid balance and monthly statements."
  dark
>
  <PageIntro
    eyebrow="The Portal"
    title="One portal for your calls, your agents and your money."
    intro="Every client gets a Life Leads Plus portal login. What you see depends on how you take calls."
    secondary={{ label: 'Client login', href: loginHref }}
  />

  {features.map((f, i) => (
    <section class:list={['section', { 'bg-paper': i % 2 === 1 }]} aria-labelledby={`f-${f.id}`}>
      <div class:list={['container feature', { flip: i % 2 === 1 }]}>
        <div class="section-head" data-reveal>
          <p class="pill">{f.tab}</p>
          <h2 id={`f-${f.id}`}>{f.title}</h2>
          <CheckList items={f.bullets} class="mt-8" />
        </div>
        <BrowserFrame shot={f.shot} alt={f.alt} eager={i === 0} />
      </div>
    </section>
  ))}

  <section class="section navy" aria-labelledby="also-title">
    <div class="container">
      <SectionHead
        eyebrow="More"
        title="Also in the portal"
        lead="The rest of what comes with every client login."
        id="also-title"
      />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {also.map(([icon, title]) => (
          <li class="card card-pad card-interactive flex items-center gap-4" data-reveal>
            <IconBadge name={icon} dark />
            <h3 class="text-[1.125rem]">{title}</h3>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .feature {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .feature {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }
    .feature.flip {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .feature.flip > :first-child {
      order: 2;
    }
  }
</style>
