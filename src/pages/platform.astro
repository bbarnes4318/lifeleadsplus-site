---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Shot from '../components/Shot.astro';
import CtaBand from '../components/CtaBand.astro';
import { features } from '../lib/features';

const also = [
  'Call log with recordings',
  'Delivery hours, states and daily caps',
  'Returns',
  'Monthly statements',
  'Browser softphone for your agents',
  'Password reset and invites for your team',
];
---

<Base
  title="The Client Portal | Life Leads Plus"
  description="Every Life Leads Plus client gets a portal login for calls, recordings, agents, applications, prepaid balance and monthly statements."
>
  <PageIntro
    eyebrow="The Portal"
    title="One portal for your calls, your agents and your money."
    intro="Every client gets a Life Leads Plus portal login. What you see depends on how you take calls."
  />

  <div class="section">
    <div class="container story">
      <div class="story-list">
        {features.map((f, i) => (
          <section class="story-item" aria-labelledby={`f-${f.id}`} data-story={i}>
            <Shot shot={f.shot} alt={f.alt} class="story-inline" eager={i === 0} />
            <div data-reveal>
              <h2 id={`f-${f.id}`} class="text-[1.75rem]">
                {f.title}
              </h2>
              <ul class="ticks mt-5">
                {f.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          </section>
        ))}
      </div>
      <div class="story-stage" aria-hidden="true">
        {features.map((f, i) => (
          <div class:list={['story-shot', { active: i === 0 }]} data-shot={i}>
            <Shot shot={f.shot} alt="" />
          </div>
        ))}
      </div>
    </div>
  </div>

  <section class="section bg-paper" aria-labelledby="also-title">
    <div class="container">
      <h2 id="also-title" data-reveal>
        Also in the portal
      </h2>
      <ul class="ticks mt-8 sm:grid-cols-2" data-reveal>
        {also.map((a) => (
          <li>{a}</li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .story-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 5rem;
  }
  .story-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  .story-stage {
    display: none;
  }
  /* Desktop: text scrolls on the left, the matching crop stays pinned on the right. */
  @media (min-width: 1024px) {
    .story {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 4rem;
    }
    .story-list {
      gap: 0;
    }
    .story-item {
      min-height: 70vh;
      align-content: center;
    }
    .story-item :global(.story-inline) {
      display: none;
    }
    .story-stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      height: calc(100vh - var(--header-h) - 4rem);
      align-items: center;
    }
    .story-shot {
      grid-area: 1 / 1;
      opacity: 0;
      transition: opacity 300ms var(--ease);
    }
    .story-shot.active {
      opacity: 1;
    }
  }
</style>

<script>
  // Swap the pinned crop to match the feature crossing the middle of the viewport.
  const shots = [...document.querySelectorAll<HTMLElement>('[data-shot]')];
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const i = Number((e.target as HTMLElement).dataset.story);
        shots.forEach((s, j) => s.classList.toggle('active', i === j));
      }),
    { rootMargin: '-45% 0px -45% 0px' },
  );
  document.querySelectorAll('[data-story]').forEach((el) => io.observe(el));
</script>
