---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { STATES, VERTICALS, PROGRAMS, TAKE_CALLS, TIMES, TIME_ZONES } from '../lib/apply';
import { phone, telHref, email } from '../lib/site';

const req = '<span class="req" aria-hidden="true">*</span>';
---

<Base
  title="Get Started | Life Leads Plus"
  description="Tell us about your agency — licensed states, agents, verticals and volume — and we’ll reply with your program and rate for live Final Expense and Medicare calls."
>
  <section class="bg-paper border-rule border-b">
    <div class="container py-12 md:py-16">
      <p class="eyebrow">Get started</p>
      <h1 class="mt-4">Tell us about your agency.</h1>
      <p class="lead mt-4">We’ll reply with your program and rate.</p>
    </div>
  </section>

  <section class="container grid gap-10 py-12 md:py-16 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-14">
    <div>
      <div id="apply-success" class="card p-8" tabindex="-1" hidden>
        <h2 class="text-2xl">Thanks — we got it.</h2>
        <p class="text-ink-2 mt-2">We’ll reply with your program and rate.</p>
      </div>

      <form id="apply-form" class="grid gap-7" novalidate>
        <noscript>
          <p class="form-alert">Please turn on JavaScript to send this form.</p>
        </noscript>

        <div class="grid gap-7 sm:grid-cols-2">
          <div class="field">
            <label for="agency">
              Agency name <Fragment set:html={req} />
            </label>
            <input
              id="agency"
              name="agency"
              autocomplete="organization"
              aria-required="true"
              aria-describedby="err-agency"
              maxlength="200"
            />
            <p class="error" id="err-agency" hidden></p>
          </div>
          <div class="field">
            <label for="name">
              Your name <Fragment set:html={req} />
            </label>
            <input
              id="name"
              name="name"
              autocomplete="name"
              aria-required="true"
              aria-describedby="err-name"
              maxlength="200"
            />
            <p class="error" id="err-name" hidden></p>
          </div>
          <div class="field">
            <label for="email">
              Email <Fragment set:html={req} />
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              aria-required="true"
              aria-describedby="err-email"
              maxlength="200"
            />
            <p class="error" id="err-email" hidden></p>
          </div>
          <div class="field">
            <label for="phone">
              Mobile phone <Fragment set:html={req} />
            </label>
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              aria-required="true"
              aria-describedby="err-phone"
              maxlength="40"
            />
            <p class="error" id="err-phone" hidden></p>
          </div>
        </div>

        <fieldset class="field" aria-describedby="err-states">
          <legend>
            States you’re licensed in <Fragment set:html={req} />
          </legend>
          <ul class="chips" data-chips aria-label="Selected states"></ul>
          <input
            type="search"
            class="mt-2"
            placeholder="Search states"
            aria-label="Search states"
            aria-controls="state-list"
            data-state-search
            autocomplete="off"
          />
          <div id="state-list" class="state-list">
            {Object.entries(STATES).map(([code, label]) => (
              <label class="check" data-state-name={label.toLowerCase()}>
                <input type="checkbox" name="states" value={code} data-label={label} />
                {label}
              </label>
            ))}
          </div>
          <p class="error" id="err-states" hidden></p>
        </fieldset>

        <div class="grid gap-7 sm:grid-cols-2">
          <div class="field">
            <label for="agents">
              Number of licensed agents <Fragment set:html={req} />
            </label>
            <input
              id="agents"
              name="agents"
              type="number"
              min="1"
              max="1000"
              step="1"
              inputmode="numeric"
              aria-required="true"
              aria-describedby="err-agents"
            />
            <p class="error" id="err-agents" hidden></p>
          </div>
          <div class="field">
            <label for="callsPerDay">Calls you want per day</label>
            <input
              id="callsPerDay"
              name="callsPerDay"
              type="number"
              min="1"
              step="1"
              inputmode="numeric"
              aria-describedby="err-callsPerDay"
            />
            <p class="error" id="err-callsPerDay" hidden></p>
          </div>
        </div>

        <fieldset class="field" aria-describedby="err-verticals">
          <legend>
            Verticals <Fragment set:html={req} />
          </legend>
          <div class="options">
            {VERTICALS.map((v) => (
              <label class="check">
                <input type="checkbox" name="verticals" value={v} />
                {v}
              </label>
            ))}
          </div>
          <p class="error" id="err-verticals" hidden></p>
        </fieldset>

        <fieldset class="field" aria-describedby="err-program">
          <legend>
            Program <Fragment set:html={req} />
          </legend>
          <div class="options">
            {PROGRAMS.map((v) => (
              <label class="check">
                <input type="radio" name="program" value={v} />
                {v}
              </label>
            ))}
          </div>
          <p class="error" id="err-program" hidden></p>
        </fieldset>

        <fieldset class="field" aria-describedby="err-takeCalls">
          <legend>
            How will your agents take calls? <Fragment set:html={req} />
          </legend>
          <div class="options">
            {TAKE_CALLS.map((v) => (
              <label class="check">
                <input type="radio" name="takeCalls" value={v} />
                {v}
              </label>
            ))}
          </div>
          <p class="error" id="err-takeCalls" hidden></p>
        </fieldset>

        <fieldset class="field" aria-describedby="err-hours">
          <legend>Delivery hours</legend>
          <div class="grid gap-3 sm:grid-cols-3">
            <select name="hoursFrom" aria-label="Start time">
              <option value="">Start time</option>
              {TIMES.map(([v, l]) => (
                <option value={v}>{l}</option>
              ))}
            </select>
            <select name="hoursTo" aria-label="End time">
              <option value="">End time</option>
              {TIMES.map(([v, l]) => (
                <option value={v}>{l}</option>
              ))}
            </select>
            <select name="timezone" aria-label="Time zone">
              <option value="">Time zone</option>
              {TIME_ZONES.map((z) => (
                <option value={z}>{z}</option>
              ))}
            </select>
          </div>
          <p class="error" id="err-hours" hidden></p>
        </fieldset>

        <div class="field">
          <label for="notes">Anything else</label>
          <textarea
            id="notes"
            name="notes"
            rows="4"
            maxlength="1000"
            aria-describedby="notes-hint err-notes"
          ></textarea>
          <p class="hint" id="notes-hint">
            Up to 1000 characters.
          </p>
          <p class="error" id="err-notes" hidden></p>
        </div>

        <div class="hp" aria-hidden="true">
          <label for="company_website">Company website</label>
          <input id="company_website" name="company_website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field">
          <label class="check items-start">
            <input
              type="checkbox"
              name="consent"
              aria-required="true"
              aria-describedby="err-consent"
              class="mt-1"
            />
            <span>
              I agree that Life Leads Plus may contact me about its programs by phone, text and
              email at the number and address above. <Fragment set:html={req} />
            </span>
          </label>
          <p class="error" id="err-consent" hidden></p>
        </div>

        <div id="form-status" role="status" aria-live="polite"></div>

        <div>
          <button type="submit" class="btn btn-primary min-w-[200px]">
            <span class="spinner" aria-hidden="true" hidden></span>
            <span data-label>Send application</span>
          </button>
        </div>
      </form>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start" aria-labelledby="next-title">
      <div class="card bg-paper p-7">
        <h2 id="next-title" class="text-xl">
          What happens next
        </h2>
        <ol class="mt-5 grid gap-5">
          {[
            'We review your states and volume.',
            'We send your program, rate and agreement.',
            'You fund your balance and we set your first delivery day.',
          ].map((s, i) => (
            <li class="flex gap-3">
              <span class="num" aria-hidden="true">
                {i + 1}
              </span>
              <span class="text-ink-2">{s}</span>
            </li>
          ))}
        </ol>
        {(phone || email) && (
          <ul class="border-rule mt-6 grid gap-2 border-t pt-5 text-[0.9375rem]">
            {phone && (
              <li>
                <a href={telHref} class="flex items-center gap-2">
                  <Icon name="phone" size={16} />
                  {phone}
                </a>
              </li>
            )}
            {email && (
              <li>
                <a href={`mailto:${email}`} class="flex items-center gap-2">
                  <Icon name="mail" size={16} />
                  {email}
                </a>
              </li>
            )}
          </ul>
        )}
      </div>
    </aside>
  </section>
</Base>

<style>
  .field {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }
  label,
  legend {
    font-weight: 600;
    color: var(--ink);
    font-size: 0.975rem;
  }
  legend {
    margin-bottom: 0.5rem;
  }
  :global(.req) {
    color: var(--ink-3);
  }
  input:not([type='checkbox'], [type='radio']),
  select,
  textarea {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid #b7c2d2;
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
  }
  input[type='checkbox'],
  input[type='radio'] {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    accent-color: var(--blue-strong);
  }
  [aria-invalid='true'] {
    border-color: #b42318 !important;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 500;
    color: var(--ink-2);
    cursor: pointer;
  }
  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
  }
  .state-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 0.25rem 1rem;
    max-height: 240px;
    overflow-y: auto;
    margin-top: 0.5rem;
    padding: 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
  }
  .state-list .check {
    padding: 0.25rem 0;
  }
  .state-list .check[hidden] {
    display: none;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .chips :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 32px;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: var(--blue-tint);
    color: var(--navy);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .error {
    color: #b42318;
    font-size: 0.9rem;
    font-weight: 550;
  }
  .hint {
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  :global(.form-alert) {
    padding: 0.875rem 1rem;
    border: 1px solid #f4c7c3;
    border-radius: 6px;
    background: #fef3f2;
    color: #b42318;
    font-weight: 550;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: #fff;
    border-radius: 999px;
    animation: spin 0.8s linear infinite;
  }
  .spinner[hidden] {
    display: none;
  }
  button:disabled {
    opacity: 0.8;
    cursor: progress;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--navy);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
  }
</style>

<script>
  import { applySchema, fieldErrors } from '../lib/apply';

  const GENERIC = 'Something went wrong sending your application. Please try again.';
  const form = document.querySelector<HTMLFormElement>('#apply-form')!;
  const status = document.querySelector<HTMLElement>('#form-status')!;
  const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  const started = Date.now();

  // States: search filter + removable chips.
  const search = form.querySelector<HTMLInputElement>('[data-state-search]')!;
  const chips = form.querySelector<HTMLElement>('[data-chips]')!;
  const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name=states]')];
  search.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    form.querySelectorAll<HTMLElement>('[data-state-name]').forEach((el) => {
      el.hidden = !el.dataset.stateName!.includes(q);
    });
  });
  search.addEventListener('keydown', (e) => e.key === 'Enter' && e.preventDefault());
  const renderChips = () => {
    chips.replaceChildren(
      ...boxes
        .filter((b) => b.checked)
        .map((b) => {
          const li = document.createElement('li');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = `${b.dataset.label} ×`;
          btn.setAttribute('aria-label', `Remove ${b.dataset.label}`);
          btn.addEventListener('click', () => {
            b.checked = false;
            renderChips();
            search.focus();
          });
          li.append(btn);
          return li;
        }),
    );
  };
  boxes.forEach((b) => b.addEventListener('change', renderChips));

  const collect = () => {
    const fd = new FormData(form);
    const str = (k: string) => (fd.get(k) as string | null) ?? undefined;
    return {
      agency: str('agency'),
      name: str('name'),
      email: str('email'),
      phone: str('phone'),
      states: fd.getAll('states'),
      agents: str('agents'),
      verticals: fd.getAll('verticals'),
      program: str('program'),
      takeCalls: str('takeCalls'),
      callsPerDay: str('callsPerDay'),
      hoursFrom: str('hoursFrom'),
      hoursTo: str('hoursTo'),
      timezone: str('timezone'),
      notes: str('notes'),
      consent: fd.get('consent') === 'on',
    };
  };

  const controls = (key: string) =>
    form.querySelectorAll<HTMLElement>(
      key === 'hours' ? 'select' : `[name="${key}"]:not([type=checkbox][name=states])`,
    );

  const clearErrors = () => {
    form.querySelectorAll<HTMLElement>('.error').forEach((el) => {
      el.hidden = true;
      el.textContent = '';
    });
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    status.replaceChildren();
  };

  const showErrors = (errors: Record<string, string>) => {
    let first: HTMLElement | null = null;
    for (const [key, message] of Object.entries(errors)) {
      const el = form.querySelector<HTMLElement>(`#err-${key}`);
      if (!el) continue;
      el.textContent = message;
      el.hidden = false;
      const ctrls = key === 'states' ? [search] : [...controls(key)];
      ctrls.forEach((c) => c.setAttribute('aria-invalid', 'true'));
      first ??= ctrls[0] ?? null;
    }
    first?.focus();
  };

  const showStatus = (message: string) => {
    const p = document.createElement('p');
    p.className = 'form-alert';
    p.textContent = message;
    status.replaceChildren(p);
  };

  const busy = (on: boolean) => {
    button.disabled = on;
    button.querySelector<HTMLElement>('.spinner')!.hidden = !on;
    button.querySelector<HTMLElement>('[data-label]')!.textContent = on
      ? 'Sending…'
      : 'Send application';
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();
    const data = collect();
    const result = applySchema.safeParse(data);
    if (!result.success) return showErrors(fieldErrors(result.error));

    busy(true);
    try {
      const res = await fetch('/api/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...data,
          company_website: (form.elements.namedItem('company_website') as HTMLInputElement).value,
          started,
        }),
      });
      if (res.ok) {
        form.remove();
        const done = document.querySelector<HTMLElement>('#apply-success')!;
        done.hidden = false;
        done.focus();
        return;
      }
      const body = await res.json().catch(() => ({}));
      if (body.errors) showErrors(body.errors);
      else showStatus(res.status === 502 ? GENERIC : (body.error ?? GENERIC));
    } catch {
      showStatus(GENERIC);
    } finally {
      busy(false);
    }
  });
</script>
