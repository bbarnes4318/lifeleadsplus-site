---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import IntroPriceCard from '../components/IntroPriceCard.astro';
import SectionHead from '../components/SectionHead.astro';
import Flow from '../components/Flow.astro';
import QualificationSection from '../components/QualificationSection.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import CheckList from '../components/CheckList.astro';
import IconBadge from '../components/IconBadge.astro';
import FaqStrip from '../components/FaqStrip.astro';
import CtaBand from '../components/CtaBand.astro';

const intro =
  'Live, pre-screened Final Expense and Medicare callers go straight to your agents. No application, no charge. No timers, no per-minute penalties.';

const rate = [
  ['badge-dollar-sign', 'From $199', 'Per submitted application, Final Expense or Medicare.'],
  [
    'sliders-horizontal',
    'Moves with conversion',
    'Your rate goes up or down as your agents’ conversion changes.',
  ],
  [
    'receipt',
    'Prepaid',
    'Fund your balance up front. Each application draws from it. No invoices.',
  ],
] as const;

const needs = [
  ['users', 'Licensed agents', 'Licensed in the states you want calls from.'],
  ['headset', 'A browser', 'Your agents take calls and log applications right in the portal.'],
  ['wallet', 'A prepaid balance', 'Fund it once and top it up from the portal whenever you need.'],
] as const;
---

<Base
  title="Pay Per Application Insurance Leads | Life Leads Plus"
  description="Pay per submitted application, from $199 for Final Expense and Medicare. Live calls to your licensed agents. You’re charged only for applications they submit."
  dark
>
  <PageIntro
    eyebrow="Pay-Per-App (PPA)"
    title="You pay $0 unless your agent submits an application."
    intro={intro}
    cta="/get-started?program=ppa"
    secondary={{ label: 'How it’s counted', href: '#counted-title' }}
  >
    <IntroPriceCard program="ppa" slot="aside" />
  </PageIntro>

  <section class="section" aria-labelledby="counted-title">
    <div class="container">
      <SectionHead
        eyebrow="How it’s counted"
        title="One charge: the submitted application."
        lead="Your agent logs the application during the call. That’s the only thing you’re billed for."
        id="counted-title"
      />
      <div class="mt-12">
        <Flow
          items={[
            {
              title: 'Call connects',
              icon: 'phone-incoming',
              body: 'A screened caller transfers live to your agent.',
            },
            {
              title: 'Your agent answers in a browser',
              icon: 'monitor',
              body: 'No phone system and no dialer.',
            },
            {
              title: 'Application logged on the call',
              icon: 'clipboard-check',
              body: 'Your agent logs it before they hang up.',
            },
            {
              title: 'You’re charged',
              icon: 'wallet',
              body: 'One charge from your prepaid balance. Calls that don’t close cost nothing.',
            },
          ]}
        />
      </div>
    </div>
  </section>

  <QualificationSection bg="paper" />

  <section class="section" aria-labelledby="see-title">
    <div class="container see-grid">
      <div>
        <SectionHead
          eyebrow="Full visibility"
          title="See every application you paid for."
          lead="Each application sits next to the call it came from, recording included. Nothing gets charged that you can’t see."
          id="see-title"
        />
        <CheckList
          class="mt-8"
          items={[
            'Carrier, face amount and premium on every application',
            'The call and recording behind each one',
            'Closing percentage by agent and by day',
          ]}
        />
      </div>
      <BrowserFrame
        shot="applications"
        alt="Applications page listing carrier, plan, face amount, premium and agent for each application"
      />
    </div>
  </section>

  <section class="section navy" aria-labelledby="rate-title">
    <div class="container">
      <SectionHead
        eyebrow="Your rate"
        title="Starts at $199. Moves with your conversion."
        lead="Every program starts at $199 per submitted application for Final Expense and Medicare. Your rate follows your agents’ conversion, so what you pay tracks what they close."
        id="rate-title"
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3" data-reveal-group>
        {rate.map(([icon, title, body]) => (
          <div class="card card-pad" data-reveal>
            <IconBadge name={icon} dark />
            <h3 class="mt-5">{title}</h3>
            <p class="mt-2">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="need-title">
    <div class="container">
      <SectionHead
        eyebrow="What you need"
        title="What you need to start."
        lead="No dialer or phone system required."
        id="need-title"
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3" data-reveal-group>
        {needs.map(([icon, title, body]) => (
          <div class="card card-pad card-interactive" data-reveal>
            <IconBadge name={icon} />
            <h3 class="mt-5">{title}</h3>
            <p class="text-ink-2 mt-2">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqStrip
    lead="Common questions about pay per application."
    items={[
      ['Do my agents need a dialer?', 'No. They take calls in the portal, in their browser.'],
      [
        'What if an agent forgets to log an application?',
        'Every call and every application show side by side in your portal, so a call without an application stands out.',
      ],
      ['Can I switch to pay per call later?', 'Yes. Tell us and we’ll move your program.'],
    ]}
  />

  <CtaBand />
</Base>

<style>
  .see-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .see-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
</style>
