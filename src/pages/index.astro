---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import IconBadge from '../components/IconBadge.astro';
import CtaBand from '../components/CtaBand.astro';
import Frame from '../components/Frame.astro';
import Flow from '../components/Flow.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import CheckList from '../components/CheckList.astro';
import SectionHead from '../components/SectionHead.astro';
import { features } from '../lib/features';
import { loginHref, siteUrl } from '../lib/site';

const platformSteps = [
  {
    title: 'Answer the call',
    icon: 'headset',
    body: 'Your agent works the conversation through the platform.',
  },
  {
    title: 'See the customer',
    icon: 'user',
    body: 'Customer information is available alongside the interaction.',
  },
  {
    title: 'Record the outcome',
    icon: 'clipboard-check',
    body: 'Dispositions and notes give your team a record of what happened.',
  },
  {
    title: 'Keep working it',
    icon: 'calendar-clock',
    body: 'Follow-up and activity stay connected to the customer.',
  },
  {
    title: 'See the activity',
    icon: 'eye',
    body: 'Agencies can maintain visibility into what their agents are doing.',
  },
] as const;

const showcase = ['agents', 'applications', 'customers', 'statements'].map((id) =>
  features.find((f) => f.id === id)!,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Life Leads Plus',
  url: `${siteUrl}/`,
  logo: `${siteUrl}/brand/wordmark.png`,
};
---

<Base
  title="Final Expense and Medicare Calls for Licensed Agents | Life Leads Plus"
  description="Final Expense and Medicare calls for licensed agents and agencies, with the platform to receive, work and track every conversation. No offshore call center. No buying blind."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Life Leads Plus</p>
        <h1 class="mt-4">You’ve paid for enough bad calls.</h1>
        <p class="lead text-navy mt-6 font-semibold">Insurance calls should be worth answering.</p>
        <p class="lead mt-4">
          Life Leads Plus gives licensed agents and agencies access to{' '}
          <strong>Final Expense and Medicare calls</strong> through a platform built to make the
          entire process more transparent — from the moment the call reaches your agent to what
          happens after they hang up.
        </p>
        <ul class="nos">
          <li>
            <Icon name="x" size={18} />
            No offshore call center.
          </li>
          <li>
            <Icon name="x" size={18} />
            No mystery behind the conversation.
          </li>
          <li>
            <Icon name="x" size={18} />
            No buying blind.
          </li>
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/get-started" class="btn btn-primary" data-cta="hero">
            Get Started
            <Icon name="arrow-right" size={18} />
          </a>
          <a href={loginHref} class="btn btn-secondary">
            Sign In
          </a>
        </div>
      </div>
      <Frame
        shot="agents-floor"
        alt="The Life Leads Plus portal showing agents who are ready, on a call, and their calls and applications today"
        sizes="(min-width: 1248px) 672px, (min-width: 1024px) calc((100vw - 96px) * 7 / 12), calc(100vw - 32px)"
        hero
      />
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="trust-title">
    <div class="container narrow" data-reveal>
      <h2 id="trust-title">The insurance call business has a trust problem.</h2>
      <p class="lead mt-6">Agents know what it feels like.</p>
      <ul class="beats mt-6">
        <li>You pay for a “live transfer.”</li>
        <li>Someone comes on the line.</li>
        <li>The consumer isn’t who you expected.</li>
        <li>The conversation isn’t what you were promised.</li>
        <li>The caller is somewhere halfway around the world.</li>
        <li>Or the call has already been worked by someone else.</li>
        <li class="strong">And you’re still paying for it.</li>
      </ul>
      <p class="lead text-navy mt-6 font-semibold">That’s not how we want to do business.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="better-title">
    <div class="container narrow">
      <SectionHead
        eyebrow="A better way to buy calls"
        title="Know what you’re buying. Know who you’re talking to."
        id="better-title"
      />
      <div class="copy mt-6" data-reveal>
        <p>
          Life Leads Plus was built for licensed insurance professionals who are tired of treating
          every call purchase like a gamble.
        </p>
        <p>
          We provide <strong>Final Expense and Medicare calls</strong> through a U.S.-focused
          operation and give the agent the technology to receive, work, and track those
          conversations.
        </p>
        <p>The goal isn’t to sell you the most calls possible.</p>
        <p>It’s to give you a better experience with the calls you actually buy.</p>
      </div>
    </div>
  </section>

  <section class="section navy" aria-labelledby="offshore-title">
    <div class="container narrow">
      <SectionHead
        eyebrow="Not an offshore transfer center."
        title="We’re on this side of the conversation."
        id="offshore-title"
      />
      <div class="copy mt-6" data-reveal>
        <p>
          Your customer isn’t handed off to an overseas call center and passed around until somebody
          takes the transfer.
        </p>
        <p>
          Life Leads Plus is built around getting insurance conversations into the hands of{' '}
          <strong>licensed agents</strong>.
        </p>
        <p>That distinction matters.</p>
        <p>Because when you’re paying for a call, you should know what you’re paying for.</p>
      </div>
    </div>
  </section>

  <section class="section bg-paper" aria-label="Final Expense and Medicare">
    <div class="container grid gap-6 lg:grid-cols-2" data-reveal-group>
      <article id="final-expense" class="card card-pad vertical" data-reveal>
        <IconBadge name="shield-heart" />
        <p class="eyebrow mt-5">Final Expense</p>
        <h2 class="mt-3 text-[1.75rem]">
          Put real conversations in front of your Final Expense agents.
        </h2>
        <div class="copy mt-5">
          <p>Final Expense remains a phone business.</p>
          <p>
            Your agents need people to talk to — not another spreadsheet, another recycled lead, or
            another transfer that falls apart the moment they answer.
          </p>
          <p>
            Life Leads Plus delivers Final Expense calls through a system designed around the agent
            experience.
          </p>
          <p>
            Your agents answer. They have the conversation. They work the opportunity. And the
            activity stays connected to the customer.
          </p>
        </div>
        <div class="mt-auto pt-8">
          <a href="/get-started" class="btn btn-primary" data-cta="final_expense">
            Get Final Expense Calls
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </article>
      <article id="medicare" class="card card-pad vertical" data-reveal>
        <IconBadge name="heart-pulse" />
        <p class="eyebrow mt-5">Medicare</p>
        <h2 class="mt-3 text-[1.75rem]">
          Give your Medicare agents conversations they can actually work.
        </h2>
        <div class="copy mt-5">
          <p>
            Medicare is too important for your agents to spend their day sorting through
            questionable leads and bad transfers.
          </p>
          <p>
            Life Leads Plus provides Medicare calls to licensed agents and gives them the platform
            to manage the conversation and everything that follows.
          </p>
        </div>
        <div class="mt-auto pt-8">
          <a href="/get-started" class="btn btn-primary" data-cta="medicare">
            Get Medicare Calls
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="difference-title">
    <div class="container two-col">
      <div>
        <SectionHead
          eyebrow="The Life Leads Plus difference"
          title="We’re not trying to hide the call from you."
          id="difference-title"
        />
        <ul class="beats mt-6" data-reveal>
          <li>You should be able to understand what you’re buying.</li>
          <li>You should know where the conversation came from.</li>
          <li>You should know what happened when your agent answered.</li>
          <li>And your organization should have a record of the activity.</li>
        </ul>
        <p class="lead mt-6">
          That’s why the call and the technology around the call live in the same system.
        </p>
      </div>
      <div>
        <SectionHead
          eyebrow="Your call. Your agent. Your customer."
          title="The relationship shouldn’t disappear after the transfer."
        />
        <div class="copy mt-6" data-reveal>
          <p>This is where Life Leads Plus is different.</p>
          <p>
            When an agent receives a call, the conversation becomes part of your team’s workflow —
            not a disposable transaction that disappears the second the transfer connects.
          </p>
        </div>
        <ul class="tags mt-6" data-reveal>
          <li>Customer information</li>
          <li>Call activity</li>
          <li>Dispositions</li>
          <li>Notes</li>
          <li>Follow-up</li>
          <li>Recordings where applicable</li>
        </ul>
        <p class="lead mt-6">The pieces surrounding the conversation stay together.</p>
      </div>
    </div>
  </section>

  <section id="platform" class="section navy" aria-labelledby="platform-title">
    <div class="container">
      <SectionHead
        eyebrow="And then there’s the platform."
        title="Because the call is only the beginning."
        lead="Life Leads Plus includes the technology your agents use to work the calls. They don’t need to bounce between a transfer provider, a separate dialer, a CRM, spreadsheets, and whatever else they’ve accumulated over the years. They can work the conversation inside the Life Leads Plus environment."
        id="platform-title"
      />
      <div class="mt-12">
        <Flow items={[...platformSteps]} dark />
      </div>

      <div class="segmented mt-16" role="tablist" aria-label="Portal features" data-tabs>
        {showcase.map((f, i) => (
          <button
            type="button"
            role="tab"
            id={`stab-${f.id}`}
            aria-controls={`spanel-${f.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {f.tab}
          </button>
        ))}
      </div>
      {showcase.map((f, i) => (
        <div
          class="showcase-panel"
          role="tabpanel"
          id={`spanel-${f.id}`}
          aria-labelledby={`stab-${f.id}`}
          hidden={i !== 0}
        >
          <BrowserFrame shot={f.shot} alt={f.alt} dark />
          <div>
            <h3 class="text-[1.625rem]">{f.title}</h3>
            <CheckList items={f.bullets} dark class="mt-5" />
            <a href="/platform" class="link-arrow mt-8">
              See the platform
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="blind-title">
    <div class="container two-col">
      <div>
        <SectionHead
          eyebrow="Stop buying blind."
          title="Start building an insurance sales operation you can actually see."
          id="blind-title"
        />
        <p class="lead mt-6">
          Life Leads Plus gives agencies something they don’t get from a disconnected transfer
          marketplace: <strong class="text-navy">visibility.</strong>
        </p>
        <ul class="beats mt-6" data-reveal>
          <li>You can see the calls.</li>
          <li>You can see the activity.</li>
          <li>You can see what your agents are doing with the opportunities you’re paying for.</li>
          <li>And your agents have one place to work them.</li>
        </ul>
      </div>
      <div>
        <SectionHead
          eyebrow="The economics matter."
          title="Your agents shouldn’t have to gamble on every call."
        />
        <p class="lead mt-6">
          Whether you’re buying on a <strong>CPA or CPL basis</strong>, the economics only work when
          the underlying opportunity is worth working.
        </p>
        <ul class="beats mt-6" data-reveal>
          <li>That means the quality of the conversation matters.</li>
          <li>The experience of the agent matters.</li>
          <li>The ability to track what happened matters.</li>
          <li>
            And ultimately, the relationship between the call provider and the agency matters.
          </li>
        </ul>
        <p class="lead text-navy mt-6 font-semibold">Life Leads Plus is built around all four.</p>
      </div>
    </div>
  </section>

  <section class="section bg-paper" aria-label="For agencies and agents">
    <div class="container grid gap-6 lg:grid-cols-2" data-reveal-group>
      <article class="card card-pad" data-reveal>
        <IconBadge name="users" />
        <p class="eyebrow mt-5">For agencies</p>
        <h2 class="mt-3 text-[1.75rem]">
          If you’re putting money behind your agents, you should know what you’re buying.
        </h2>
        <div class="copy mt-5">
          <p>
            Life Leads Plus gives agencies a centralized environment for their agents to receive and
            work Final Expense and Medicare calls.
          </p>
          <p>
            Your agents get the calls. Your organization gets the platform. And everyone works from
            the same record of what happened.
          </p>
        </div>
      </article>
      <article class="card card-pad" data-reveal>
        <IconBadge name="user-check" />
        <p class="eyebrow mt-5">For agents</p>
        <h2 class="mt-3 text-[1.75rem]">You became an insurance agent to sell insurance.</h2>
        <div class="copy mt-5">
          <p>
            Not to spend your day fighting bad transfers. Not to argue about whether a call was
            legitimate. Not to chase down information that should have been available in the first
            place.
          </p>
          <p>
            And definitely not to wonder what happened to the customer after the call disappeared
            into somebody else’s system.
          </p>
        </div>
        <CheckList
          class="mt-5"
          items={[
            'Get calls you can work.',
            'Use a platform you can see.',
            'Know what happened next.',
          ]}
        />
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="bottom-title">
    <div class="container narrow">
      <SectionHead
        eyebrow="The bottom line"
        title="Better calls start with a better way of doing business."
        lead="Life Leads Plus provides Final Expense and Medicare calls to licensed insurance professionals — without building the business around offshore transfers and opaque call practices."
        id="bottom-title"
      />
      <ul class="beats mt-6" data-reveal>
        <li>The calls matter.</li>
        <li>The agent matters.</li>
        <li>The customer matters.</li>
        <li>And the agency paying for the opportunity matters.</li>
      </ul>
      <p class="lead text-navy mt-6 font-semibold">That’s the standard.</p>
    </div>
  </section>

  <CtaBand
    bg="paper"
    eyebrow="Ready to see the difference?"
    title="Give your agents something better to answer."
    lead="Final Expense and Medicare calls for licensed insurance professionals."
    cta="Get Started"
    signIn
  />
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  .nos {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: var(--navy);
    font-weight: 650;
  }
  .nos li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nos :global(svg) {
    color: var(--red);
  }
  .narrow {
    max-width: 52rem;
  }
  .two-col {
    display: grid;
    gap: 4rem;
  }
  @media (min-width: 1024px) {
    .two-col {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .copy {
    display: grid;
    gap: 1rem;
    font-size: 1.125rem;
    color: var(--ink-2);
  }
  .navy .copy {
    color: var(--on-navy);
  }
  .navy .copy strong {
    color: #fff;
  }
  .card .copy {
    font-size: 1rem;
  }
  .beats {
    display: grid;
    gap: 0.625rem;
    padding-left: 1.25rem;
    border-left: 3px solid var(--blue-strong);
    color: var(--ink-2);
    font-size: 1.125rem;
  }
  .beats .strong {
    color: var(--navy);
    font-weight: 700;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tags li {
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background: var(--blue-tint);
    color: var(--blue-strong);
    font-size: 0.9375rem;
    font-weight: 650;
  }
  .vertical {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    scroll-margin-top: 96px;
  }
  .showcase-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    margin-top: 2.5rem;
  }
  @media (min-width: 1024px) {
    .showcase-panel {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 3.5rem;
    }
  }
</style>
