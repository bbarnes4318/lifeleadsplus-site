---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import IconBadge from '../components/IconBadge.astro';
import CtaBand from '../components/CtaBand.astro';
import Frame from '../components/Frame.astro';
import Flow from '../components/Flow.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import CheckList from '../components/CheckList.astro';
import SectionHead from '../components/SectionHead.astro';
import QualificationSection from '../components/QualificationSection.astro';
import PricingSection from '../components/PricingSection.astro';
import ClosedLoopSection from '../components/ClosedLoopSection.astro';
import FaqStrip from '../components/FaqStrip.astro';
import { features } from '../lib/features';
import { pick } from '../lib/faqs';
import { siteUrl } from '../lib/site';

const steps = [
  {
    title: 'Apply',
    icon: 'file-pen-line',
    body: 'Tell us your licensed states, how many agents you have and how many calls you want a day.',
  },
  {
    title: 'Set up',
    icon: 'sliders-horizontal',
    body: 'Sign your agreement, fund your prepaid balance and set your states, hours and daily cap.',
  },
  {
    title: 'Take calls',
    icon: 'headset',
    body: 'Qualified callers transfer live to your agents, in the portal or on your own number.',
  },
  {
    title: 'Track everything',
    icon: 'file-text',
    body: 'Every call, recording, application and dollar in one login.',
  },
] as const;

const trust = [
  ['user-check', 'Qualified before transfer'],
  ['map-pin', 'Only your licensed states'],
  ['headset', 'Every call recorded'],
  ['wallet', 'Starts at $25 per call'],
] as const;

const controls = [
  ['states', 'map-pin', 'Your states', 'Only callers in states where your agents are licensed.'],
  ['hours', 'clock', 'Your hours', 'Calls only arrive while your agents are working.'],
  [
    'cap',
    'gauge',
    'Your daily cap',
    'Set exactly how many calls you want a day. Change it anytime.',
  ],
  [
    'rec',
    'headphones',
    'Every call recorded',
    'Hear exactly what your agent said, and what the caller said.',
  ],
  ['balance', 'wallet', 'Prepaid balance', 'You fund it, you control it. No surprise invoices.'],
  [
    'statements',
    'file-text',
    'Monthly statements',
    'A clean statement for every month, ready for your accountant.',
  ],
] as const;
const states = ['TX', 'FL', 'GA', 'NC', 'OH', 'TN', 'PA', 'AZ', 'MI', 'IN'];
// Deterministic "waveform": 40 bar heights between 20% and 100%.
const wave = Array.from({ length: 40 }, (_, i) =>
  Math.round(20 + 80 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.45))),
);

const showcase = ['agents', 'applications', 'customers', 'statements'].map((id) =>
  features.find((f) => f.id === id)!,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Life Leads Plus',
  url: `${siteUrl}/`,
  logo: `${siteUrl}/brand/wordmark.png`,
};
---

<Base
  title="Live Final Expense and Medicare Calls | Life Leads Plus"
  description="Live Final Expense and Medicare calls transferred to your licensed agents. Pay per submitted application from $199 or pay per call from $25, with every call, recording and dollar in your own portal."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Final Expense · Medicare</p>
        <!-- No whitespace inside the span: a trailing space would widen it past "way". -->
        <!-- prettier-ignore -->
        <h1 class="mt-4">
          Live insurance calls, <span class="underline-stroke">priced the way<svg viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M3 11.5C52 6.5 104 4 158 4.6c47 .5 92 3 139 6.4" fill="none" stroke="var(--red)" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke"></path></svg></span><br class="hidden lg:inline" /> your agency sells.
        </h1>
        <p class="lead mt-6">
          Callers transferred live to your licensed agents. Pay per submitted application or pay per
          call — and see every call, recording and dollar in your own portal.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/get-started" class="btn btn-primary" data-cta="hero">
            Get your rate
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="#how-title" class="btn btn-secondary">
            {' '}
            See how it works{' '}
          </a>
        </div>
        <ul class="trust">
          {trust.map(([icon, text]) => (
            <li>
              <Icon name={icon} size={18} />
              {text}
            </li>
          ))}
        </ul>
      </div>
      <Frame
        shot="agents-floor"
        alt="The Life Leads Plus portal showing agents who are ready, on a call, and their calls and applications today"
        sizes="(min-width: 1248px) 672px, (min-width: 1024px) calc((100vw - 96px) * 7 / 12), calc(100vw - 32px)"
        hero
      />
    </div>
  </section>

  <QualificationSection />

  <ClosedLoopSection />

  <PricingSection />

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <SectionHead
        eyebrow="How it works"
        title="From application to live calls."
        lead="No dialer to buy and no leads to chase. This is the whole process."
        id="how-title"
      />
      <div class="mt-12">
        <Flow items={[...steps]} />
      </div>
    </div>
  </section>

  <section class="section navy" aria-labelledby="portal-title">
    <div class="container">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          eyebrow="The portal"
          title="See every call, agent and dollar."
          lead="One login shows you exactly what you’re paying for and what it’s producing."
          id="portal-title"
        />
        <div class="segmented" role="tablist" aria-label="Portal features" data-tabs>
          {showcase.map((f, i) => (
            <button
              type="button"
              role="tab"
              id={`stab-${f.id}`}
              aria-controls={`spanel-${f.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {f.tab}
            </button>
          ))}
        </div>
      </div>
      {showcase.map((f, i) => (
        <div
          class="showcase-panel"
          role="tabpanel"
          id={`spanel-${f.id}`}
          aria-labelledby={`stab-${f.id}`}
          hidden={i !== 0}
        >
          <BrowserFrame shot={f.shot} alt={f.alt} dark />
          <div>
            <h3 class="text-[1.625rem]">{f.title}</h3>
            <CheckList items={f.bullets} dark class="mt-5" />
            <a href="/platform" class="link-arrow mt-8">
              See the portal
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="control-title">
    <div class="container">
      <SectionHead
        eyebrow="Your controls"
        title="You set the rules. We deliver inside them."
        lead="Calls only come from your states, only during your hours, and never past your daily cap."
        id="control-title"
      />
      <ul class="bento mt-12" data-reveal-group>
        {controls.map(([kind, icon, title, body]) => (
          <li class={`card card-interactive tile tile-${kind}`} data-reveal>
            <div class="tile-visual" aria-hidden="true">
              {kind === 'states' && (
                <div class="chips">
                  {states.map((s, i) => (
                    <span class:list={['chip', { on: i < 6 }]}>{s}</span>
                  ))}
                </div>
              )}
              {kind === 'hours' && (
                <div class="hours">
                  <div class="hours-bar">
                    <span class="hours-window" />
                  </div>
                  <div class="hours-ticks">
                    <span>12a</span>
                    <span>6a</span>
                    <span>12p</span>
                    <span>6p</span>
                  </div>
                </div>
              )}
              {kind === 'cap' && (
                <div class="stepper">
                  <span class="stepper-btn">
                    <Icon name="minus" size={16} />
                  </span>
                  <span class="stepper-value">Daily cap: 40</span>
                  <span class="stepper-btn">
                    <Icon name="plus" size={16} />
                  </span>
                </div>
              )}
              {kind === 'rec' && (
                <div class="rec">
                  <span class="rec-play">
                    <Icon name="play" size={14} />
                  </span>
                  <span class="wave">
                    {wave.map((h) => (
                      <span style={`height:${h}%`} />
                    ))}
                  </span>
                </div>
              )}
              {kind === 'balance' && (
                <div class="meter">
                  <span class="meter-label">Balance</span>
                  <span class="meter-bar">
                    <span />
                  </span>
                </div>
              )}
              {kind === 'statements' && (
                <div class="docs">
                  {['Aug 2026', 'Jul 2026', 'Jun 2026'].map((m) => (
                    <span class="doc">
                      <Icon name="file-text" size={14} />
                      {m} · PDF
                    </span>
                  ))}
                </div>
              )}
            </div>
            <div class="mt-6 flex items-center gap-3">
              <IconBadge name={icon} />
              <h3 class="text-[1.1875rem]">{title}</h3>
            </div>
            <p class="text-ink-2 mt-3">{body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FaqStrip
    items={pick(
      'How are Final Expense callers qualified?',
      'Who else handles my calls?',
      'How much does it cost?',
    )}
  />

  <CtaBand />
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    /* Fit "Live insurance calls," on one line of the narrower 5fr column. */
    .hero h1 {
      font-size: clamp(2.5rem, 3.4vw, 3.125rem);
    }
  }
  /* A little more line-height than other headings, so the underline has room between the
     descenders above it and the ascenders of the next line. */
  .hero h1 {
    line-height: 1.1;
  }
  .underline-stroke {
    position: relative;
    white-space: nowrap;
  }
  /* The span's box ends at the font's descent (baseline + 0.217em in Plus Jakarta Sans), but the
     "p" and "y" ink reaches baseline + 0.233em. The SVG starts at baseline + 0.107em + 1px, so the
     curve's low ends (under "p" and "y") run about 0.32em below the baseline, clear of both
     descenders, and its middle arch (about 0.18em below) stays above the next line's ascenders.
     It is inset 0.05em each side to stay within the ink of "priced the way". Pixel-tested at 360,
     390, 768, 1024 and 1440px. */
  .underline-stroke svg {
    position: absolute;
    left: 0.05em;
    top: calc(100% - 0.11em + 1px);
    width: calc(100% - 0.1em);
    height: 0.3em;
    overflow: visible;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 1.5rem;
    margin-top: 1.75rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    font-weight: 550;
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .trust :global(svg) {
    color: var(--blue-strong);
  }

  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
    /* 1 and 4 span two columns; 6 too, so the last row has no hole. */
    .tile:nth-child(1),
    .tile:nth-child(4),
    .tile:nth-child(6) {
      grid-column: span 2;
    }
  }
  .tile {
    padding: 1.5rem;
  }
  @media (min-width: 1024px) {
    .tile {
      padding: 2rem;
    }
  }
  .tile-visual {
    display: flex;
    align-items: center;
    min-height: 140px;
    padding: 1.5rem;
    border-radius: 12px;
    background: var(--grad-panel);
    border: 1px solid var(--rule);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--blue-strong);
    background: #fff;
    color: var(--blue-strong);
    font-size: 0.875rem;
    font-weight: 700;
  }
  .chip.on {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .hours {
    width: 100%;
  }
  .hours-bar {
    position: relative;
    height: 16px;
    border-radius: 999px;
    background: #dbe3ee;
  }
  .hours-window {
    position: absolute;
    left: calc(9 / 24 * 100%);
    width: calc(10 / 24 * 100%);
    top: 0;
    bottom: 0;
    border-radius: 999px;
    background: var(--blue-strong);
  }
  .hours-ticks {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 0.625rem;
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .stepper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .stepper-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--rule);
    background: #fff;
    color: var(--navy);
    box-shadow: var(--shadow-card);
  }
  .stepper-value {
    min-width: 8.5rem;
    text-align: center;
    color: var(--navy);
    font-size: 1.125rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
  }
  .rec {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }
  .rec-play {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--blue-strong);
    color: #fff;
  }
  .wave {
    display: flex;
    align-items: center;
    gap: 3px;
    flex: 1;
    height: 56px;
    min-width: 0;
    overflow: hidden;
  }
  .wave span {
    flex: 1;
    min-width: 2px;
    border-radius: 2px;
    background: var(--blue-strong);
    opacity: 0.85;
  }
  .wave span:nth-child(n + 15) {
    background: #b7c2d2;
  }
  .meter {
    display: grid;
    gap: 0.625rem;
    width: 100%;
  }
  .meter-label {
    color: var(--ink-3);
    font-size: 0.875rem;
    font-weight: 650;
  }
  .meter-bar {
    height: 14px;
    border-radius: 999px;
    background: #dbe3ee;
  }
  .meter-bar span {
    display: block;
    width: 70%;
    height: 100%;
    border-radius: inherit;
    background: var(--blue-strong);
  }
  .docs {
    display: grid;
    gap: 0.5rem;
  }
  .doc {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--rule);
    background: #fff;
    color: var(--navy);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .showcase-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    margin-top: 3rem;
  }
  @media (min-width: 1024px) {
    .showcase-panel {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 3.5rem;
    }
  }
</style>
