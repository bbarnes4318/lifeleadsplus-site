---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import IconBadge from '../components/IconBadge.astro';
import CtaBand from '../components/CtaBand.astro';
import Frame from '../components/Frame.astro';
import Flow from '../components/Flow.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import CheckList from '../components/CheckList.astro';
import SectionHead from '../components/SectionHead.astro';
import QualificationSection from '../components/QualificationSection.astro';
import ClosedLoopSection from '../components/ClosedLoopSection.astro';
import FaqStrip from '../components/FaqStrip.astro';
import { features } from '../lib/features';
import { pick } from '../lib/faqs';
import { siteUrl } from '../lib/site';

const steps = [
  {
    title: 'The call connects',
    icon: 'phone-incoming',
    status: 'No charge',
    body: 'A pre-screened caller is transferred live to your agent in the dashboard.',
  },
  {
    title: 'Your agent pitches',
    icon: 'headset',
    status: 'No charge',
    body: 'Take as long as you need. No timer tricks, no per-minute penalties.',
  },
  {
    title: 'No sale? You pay zero.',
    icon: 'circle-help',
    status: 'No charge',
    body: 'Not interested, changed their mind, hung up? No application submitted means nothing to pay.',
  },
  {
    title: 'Application submitted',
    icon: 'clipboard-check',
    status: 'Your custom rate',
    body: 'Only when your agent submits an application do you pay. You pay for production.',
  },
] as const;

const trust = [
  ['wallet', 'No application, no charge'],
  ['user-check', '6-point live screening'],
  ['headset', '100% of calls recorded'],
  ['map-pin', 'Only your licensed states'],
] as const;

const controls = [
  [
    'states',
    'map-pin',
    'Geographic precision',
    'Target strictly the states where your agents are licensed.',
  ],
  ['hours', 'clock', 'Schedule locks', 'Calls only arrive while your team is logged in and ready.'],
  [
    'cap',
    'gauge',
    'Custom daily caps',
    'Set your daily volume. Scale up or throttle down anytime.',
  ],
  [
    'rec',
    'headphones',
    '100% audio archives',
    'Listen to full recordings of every call from your call log.',
  ],
  [
    'balance',
    'wallet',
    'Real-time audit trail',
    'Every charge tracked against your prepaid balance. No mystery billing.',
  ],
  [
    'statements',
    'file-text',
    'Monthly statements',
    'A clean statement for every month, ready for your accountant.',
  ],
] as const;
const states = ['TX', 'FL', 'GA', 'NC', 'OH', 'TN', 'PA', 'AZ', 'MI', 'IN'];
// Deterministic "waveform": 40 bar heights between 20% and 100%.
const wave = Array.from({ length: 40 }, (_, i) =>
  Math.round(20 + 80 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.45))),
);

const showcase = ['agents', 'applications', 'customers', 'statements'].map((id) =>
  features.find((f) => f.id === id)!,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Life Leads Plus',
  url: `${siteUrl}/`,
  logo: `${siteUrl}/brand/wordmark.png`,
};
---

<Base
  title="Pay Only for Applications | Final Expense & Medicare Calls | Life Leads Plus"
  description="Pay only for submitted applications. Pre-screened Final Expense and Medicare calls sent straight to your agents, with custom rates for pay per application and pay per call."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Final Expense &amp; Medicare calls</p>
        <!-- No whitespace inside the span: a trailing space would widen the underline. -->
        <!-- prettier-ignore -->
        <h1>Qualified calls for your agents. You only pay for <span class="underline-stroke">applications<svg viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M3 11.5C52 6.5 104 4 158 4.6c47 .5 92 3 139 6.4" fill="none" stroke="var(--red)" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke"></path></svg></span>.</h1>
        <p class="lead hero-lead">
          Pre-screened, live Final Expense and Medicare callers sent straight to your agents, ready
          to talk coverage. Every application your team writes is the only thing you pay for.
        </p>
        <div class="hero-actions">
          <a href="/get-started" class="btn btn-primary" data-cta="hero">
            Get Your Custom Rate
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="#how-title" class="btn btn-secondary">
            See How PPA Works
          </a>
        </div>
        <ul class="trust">
          {trust.map(([icon, text]) => (
            <li>
              <Icon name={icon} size={18} />
              {text}
            </li>
          ))}
        </ul>
      </div>
      <Frame
        class="hero-frame"
        shot="agents-floor"
        alt="The Life Leads Plus dashboard showing agents who are ready, on a call, and their calls and applications today"
        sizes="(min-width: 1280px) 602px, (min-width: 1200px) calc((100vw - 104px) * 0.512), (min-width: 1024px) calc((100vw - 96px) / 2), calc(100vw - 32px)"
        hero
      />
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="how-title">
    <div class="container">
      <SectionHead
        eyebrow="The zero-risk model"
        title="How you get calls with zero risk."
        lead="Most vendors charge you for the call. We charge you for the application."
        id="how-title"
      />
      <div class="mt-12">
        <Flow items={[...steps]} />
      </div>
    </div>
  </section>

  <QualificationSection />

  <ClosedLoopSection />

  <section class="section" aria-labelledby="control-title">
    <div class="container">
      <SectionHead
        eyebrow="Total command"
        title="You set the rules. We send the calls."
        lead="Pick your states, hours and daily volume. Change them anytime."
        id="control-title"
      />
      <ul class="bento mt-12" data-reveal-group>
        {controls.map(([kind, icon, title, body]) => (
          <li class={`card card-interactive tile tile-${kind}`} data-reveal>
            <div class="tile-visual" aria-hidden="true">
              {kind === 'states' && (
                <div class="chips">
                  {states.map((s, i) => (
                    <span class:list={['chip', { on: i < 6 }]}>{s}</span>
                  ))}
                </div>
              )}
              {kind === 'hours' && (
                <div class="hours">
                  <div class="hours-bar">
                    <span class="hours-window" />
                  </div>
                  <div class="hours-ticks">
                    <span>12a</span>
                    <span>6a</span>
                    <span>12p</span>
                    <span>6p</span>
                  </div>
                </div>
              )}
              {kind === 'cap' && (
                <div class="stepper">
                  <span class="stepper-btn">
                    <Icon name="minus" size={16} />
                  </span>
                  <span class="stepper-value">Daily cap: 40</span>
                  <span class="stepper-btn">
                    <Icon name="plus" size={16} />
                  </span>
                </div>
              )}
              {kind === 'rec' && (
                <div class="rec">
                  <span class="rec-play">
                    <Icon name="play" size={14} />
                  </span>
                  <span class="wave">
                    {wave.map((h) => (
                      <span style={`height:${h}%`} />
                    ))}
                  </span>
                </div>
              )}
              {kind === 'balance' && (
                <div class="meter">
                  <span class="meter-label">Balance</span>
                  <span class="meter-bar">
                    <span />
                  </span>
                </div>
              )}
              {kind === 'statements' && (
                <div class="docs">
                  {['Aug 2026', 'Jul 2026', 'Jun 2026'].map((m) => (
                    <span class="doc">
                      <Icon name="file-text" size={14} />
                      {m} · PDF
                    </span>
                  ))}
                </div>
              )}
            </div>
            <div class="mt-6 flex items-center gap-3">
              <IconBadge name={icon} />
              <h3 class="text-[1.1875rem]">{title}</h3>
            </div>
            <p class="text-ink-2 mt-3">{body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section navy" aria-labelledby="portal-title">
    <div class="container">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          eyebrow="Real-time agency dashboard"
          title="Your entire agency in one dashboard."
          lead="See which agents are available, listen to recordings, review applications and audit agent conversion, all from one dashboard."
          id="portal-title"
        />
        <div class="segmented" role="tablist" aria-label="Dashboard features" data-tabs>
          {showcase.map((f, i) => (
            <button
              type="button"
              role="tab"
              id={`stab-${f.id}`}
              aria-controls={`spanel-${f.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {f.tab}
            </button>
          ))}
        </div>
      </div>
      {showcase.map((f, i) => (
        <div
          class="showcase-panel"
          role="tabpanel"
          id={`spanel-${f.id}`}
          aria-labelledby={`stab-${f.id}`}
          hidden={i !== 0}
        >
          <BrowserFrame shot={f.shot} alt={f.alt} dark />
          <div>
            <h3 class="text-[1.625rem]">{f.title}</h3>
            <CheckList items={f.bullets} dark class="mt-5" />
            <a href="/platform" class="link-arrow mt-8">
              See the dashboard
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <FaqStrip
    items={pick(
      'How does pay per application work?',
      'How is an application verified?',
      'What happens if a call ends quickly on pay per call?',
      'Can I use this with my existing dialer or CRM?',
    )}
  />

  <CtaBand />
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 5.5vw, 4.5rem) clamp(3.5rem, 7vw, 5.5rem);
  }
  .hero-grid {
    display: grid;
    gap: 3rem;
  }
  /* The headline is sized to its column (cqi), so it wraps the same way at every desktop width. */
  .hero-copy {
    container-type: inline-size;
  }
  .hero h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  /* 28px, not 24: the underline hangs into this gap. */
  .hero-lead {
    max-width: 36rem;
    margin-top: 1.75rem;
    line-height: 1.6;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (max-width: 479px) {
    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }
  @media (min-width: 1024px) {
    /* Even split below 1200px so both hero buttons still fit on one row. */
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
    /* Three lines: "Qualified calls for your / agents. You only pay / for applications." The
       measure is in em, so the break points hold as the size follows the column. */
    .hero h1 {
      max-width: 10.4em;
      font-size: clamp(2.625rem, 9.6cqi, 3.375rem);
      text-wrap: wrap;
    }
    /* Top of the screenshot lines up with the cap height of the headline, not the eyebrow. */
    .hero-grid > :global(.frame) {
      margin-top: 3.125rem;
    }
  }
  @media (min-width: 1200px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 3.5rem;
    }
  }
  .underline-stroke {
    position: relative;
    white-space: nowrap;
  }
  /* "applications" is always the last word, so the stroke hangs below the last line and needs no
     extra line-height. The SVG starts just under the baseline (the span's box ends at the font's
     descent, baseline + 0.217em in Plus Jakarta Sans); its low ends run about 0.32em below the
     baseline, clear of the "p" descenders, and it is inset 0.07em each side to stay within the
     ink of the word. */
  .underline-stroke svg {
    position: absolute;
    left: 0.07em;
    top: calc(100% - 0.11em + 1px);
    width: calc(100% - 0.14em);
    height: 0.3em;
    overflow: visible;
  }
  .trust {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.625rem 1.75rem;
    margin-top: 1.75rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    font-weight: 550;
  }
  @media (min-width: 480px) {
    .trust {
      grid-template-columns: repeat(2, max-content);
    }
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .trust :global(svg) {
    flex-shrink: 0;
    color: var(--blue-strong);
  }

  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
    /* 1 and 4 span two columns; 6 too, so the last row has no hole. */
    .tile:nth-child(1),
    .tile:nth-child(4),
    .tile:nth-child(6) {
      grid-column: span 2;
    }
  }
  .tile {
    padding: 1.5rem;
  }
  @media (min-width: 1024px) {
    .tile {
      padding: 2rem;
    }
  }
  .tile-visual {
    display: flex;
    align-items: center;
    min-height: 140px;
    padding: 1.5rem;
    border-radius: 12px;
    background: var(--grad-panel);
    border: 1px solid var(--rule);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--blue-strong);
    background: #fff;
    color: var(--blue-strong);
    font-size: 0.875rem;
    font-weight: 700;
  }
  .chip.on {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .hours {
    width: 100%;
  }
  .hours-bar {
    position: relative;
    height: 16px;
    border-radius: 999px;
    background: #dbe3ee;
  }
  .hours-window {
    position: absolute;
    left: calc(9 / 24 * 100%);
    width: calc(10 / 24 * 100%);
    top: 0;
    bottom: 0;
    border-radius: 999px;
    background: var(--blue-strong);
  }
  .hours-ticks {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 0.625rem;
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .stepper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .stepper-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--rule);
    background: #fff;
    color: var(--navy);
    box-shadow: var(--shadow-card);
  }
  .stepper-value {
    min-width: 8.5rem;
    text-align: center;
    color: var(--navy);
    font-size: 1.125rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
  }
  .rec {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }
  .rec-play {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--blue-strong);
    color: #fff;
  }
  .wave {
    display: flex;
    align-items: center;
    gap: 3px;
    flex: 1;
    height: 56px;
    min-width: 0;
    overflow: hidden;
  }
  .wave span {
    flex: 1;
    min-width: 2px;
    border-radius: 2px;
    background: var(--blue-strong);
    opacity: 0.85;
  }
  .wave span:nth-child(n + 15) {
    background: #b7c2d2;
  }
  .meter {
    display: grid;
    gap: 0.625rem;
    width: 100%;
  }
  .meter-label {
    color: var(--ink-3);
    font-size: 0.875rem;
    font-weight: 650;
  }
  .meter-bar {
    height: 14px;
    border-radius: 999px;
    background: #dbe3ee;
  }
  .meter-bar span {
    display: block;
    width: 70%;
    height: 100%;
    border-radius: inherit;
    background: var(--blue-strong);
  }
  .docs {
    display: grid;
    gap: 0.5rem;
  }
  .doc {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--rule);
    background: #fff;
    color: var(--navy);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .showcase-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    margin-top: 3rem;
  }
  @media (min-width: 1024px) {
    .showcase-panel {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 3.5rem;
    }
  }
</style>
