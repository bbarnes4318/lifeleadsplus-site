---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqs, CATEGORIES } from '../lib/faqs';
import { phone, telHref } from '../lib/site';
import { pricing } from '../lib/offer';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Base
  title="FAQ | Life Leads Plus"
  description="Answers about Life Leads Plus pay per application and pay per call programs: pricing from $199 and $25, caller screening, prepaid billing and the dashboard."
  jsonLd={jsonLd}
  dark
>
  <PageIntro
    eyebrow="FAQ"
    title="Frequently asked questions."
    intro="Pricing, caller screening, billing and the dashboard."
    secondary={{ label: 'See pricing', href: '/#pricing-title' }}
  />

  <section class="section" aria-labelledby="questions-title">
    <div class="container faq-grid">
      <aside class="faq-side">
        <SectionHead
          eyebrow="Browse"
          title="All questions"
          lead="Filter by topic."
          id="questions-title"
        />
        <div class="filters mt-6" role="group" aria-label="Filter questions">
          {['All', ...CATEGORIES].map((c, i) => (
            <button
              type="button"
              class="filter"
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-filter={c}
            >
              {c}
            </button>
          ))}
        </div>
        <p class="sr-only" role="status" data-filter-status></p>
        <div class="card card-pad still mt-8">
          <p class="price-note">
            {`Pay per application from $${pricing.ppa.rows[0].from} · Pay per call from $${pricing.ppc.rows[0].from}`}
          </p>
          <h3 class="mt-4 text-[1.1875rem]">Still have a question?</h3>
          <p class="text-ink-2 mt-2 text-[0.9375rem]">
            Send us your details and we’ll reply with your program, rate and agreement.
          </p>
          <a href="/get-started" class="btn btn-primary mt-5 w-full" data-cta="faq">
            Get your rate
          </a>
          {phone && (
            <a href={telHref} class="link-arrow mt-4">
              <Icon name="phone" size={16} />
              {phone}
            </a>
          )}
        </div>
      </aside>

      <div class="faq-list">
        {faqs.map(([q, a, c]) => (
          <details data-category={c}>
            <summary>
              <span>{q}</span>
              <span class="chev" aria-hidden="true">
                <Icon name="chevron-down" size={18} />
              </span>
            </summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand bg="paper" />
</Base>

<style>
  .faq-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: 320px minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
    .faq-side {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
    .filters {
      flex-direction: column;
      align-items: stretch;
    }
    .filter {
      text-align: left;
    }
  }
  .faq-side :global(h2) {
    font-size: 1.75rem;
  }
  .price-note {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--blue-tint);
    color: var(--blue-strong);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .faq-list {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  details {
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: #fff;
    transition:
      background-color 150ms,
      border-color 150ms;
  }
  details[open] {
    background: var(--paper);
    border-left: 3px solid var(--blue-strong);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 1.25rem 1.125rem 1.5rem;
    border-radius: inherit;
    cursor: pointer;
    list-style: none;
    color: var(--navy);
    font-size: 1.0625rem;
    font-weight: 650;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .chev {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--blue-tint);
    color: var(--blue-strong);
    transition: transform 0.2s;
  }
  details[open] .chev {
    transform: rotate(180deg);
  }
  details p {
    padding: 0 1.5rem 1.25rem;
    color: var(--ink-2);
  }
  /* Smooth open/close where ::details-content is supported; instant elsewhere. */
  details::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 250ms var(--ease),
      content-visibility 250ms allow-discrete;
  }
  details[open]::details-content {
    height: auto;
  }
  details[hidden] {
    display: none;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter {
    min-height: 44px;
    padding: 0.5rem 1.125rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: #fff;
    color: var(--ink-2);
    font-weight: 650;
    cursor: pointer;
    transition:
      background-color 150ms,
      color 150ms;
  }
  .filter:hover {
    border-color: var(--blue-strong);
    color: var(--navy);
  }
  .filter[aria-pressed='true'] {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
</style>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-category]')];
  const status = document.querySelector<HTMLElement>('[data-filter-status]')!;
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((d) => (d.hidden = f !== 'All' && d.dataset.category !== f));
      const n = items.filter((d) => !d.hidden).length;
      status.textContent = `Showing ${n} questions`;
    }),
  );
</script>
