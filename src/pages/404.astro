---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Life Leads Plus" description="This page doesn’t exist.">
  <section class="section">
    <div class="container py-10 text-center">
      <p class="eyebrow">404</p>
      <h1 class="mt-4">This page doesn’t exist.</h1>
      <p class="lead mx-auto mt-5">The link may be old, or the address may have a typo.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-secondary">
          Go home
        </a>
        <a href="/get-started" class="btn btn-primary">
          Get started
        </a>
      </div>
    </div>
  </section>
</Base>
