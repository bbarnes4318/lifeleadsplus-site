---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import IntroPriceCard from '../components/IntroPriceCard.astro';
import SectionHead from '../components/SectionHead.astro';
import QualificationSection from '../components/QualificationSection.astro';
import IconBadge from '../components/IconBadge.astro';
import FaqStrip from '../components/FaqStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import Flow from '../components/Flow.astro';
import Icon from '../components/Icon.astro';
import { ppcFilters } from '../lib/offer';

const intro =
  'Every program has a buffer. Calls that end before it are free. You only pay for callers who stay on the line with your agent.';
const BUFFER = 90;
const START = 70;
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
const stateChips = [
  ['TX', true],
  ['FL', true],
  ['GA', true],
  ['NC', true],
  ['OH', true],
  ['PA', false],
  ['AZ', false],
] as const;
---

<Base
  title="Pay Per Call Insurance Leads | Life Leads Plus"
  description="Pay per call from $25 per billable call for Final Expense and Medicare. You pay for calls that last past the buffer time on your agreement; your states, ages and buffer time set your price."
  dark
>
  <PageIntro
    eyebrow="Pay per call"
    title="Pay for real conversations, not hang-ups."
    intro={intro}
    cta="/get-started?program=ppc"
    secondary={{ label: 'How billing works', href: '#billing-title' }}
  >
    <IntroPriceCard program="ppc" slot="aside" />
  </PageIntro>

  <section class="section" aria-labelledby="filters-title">
    <div class="container">
      <SectionHead
        eyebrow="Pricing"
        title="From $25 a call. You set what goes into it."
        lead="Pay per call starts at $25 per billable call for Final Expense and Medicare. Three filters set your final price."
        id="filters-title"
      />
      <ul class="mt-12 grid gap-5 md:grid-cols-3" data-reveal-group data-ppc-filters>
        {ppcFilters.map((f) => (
          <li class="card card-pad card-interactive filter-card" data-reveal>
            <IconBadge name={f.icon} />
            <h3 class="mt-5">{f.title}</h3>
            <p class="text-ink-2 mt-2">{f.body}</p>
            <div class="filter-visual" aria-hidden="true">
              {f.id === 'states' && (
                <div class="fchips">
                  {stateChips.map(([s, on]) => (
                    <span class:list={['fchip', { on }]}>{s}</span>
                  ))}
                </div>
              )}
              {f.id === 'ages' && (
                <div class="range">
                  <span class="range-label">Caller ages</span>
                  <span class="range-track">
                    <span class="range-fill" />
                    <span class="range-thumb" style="left:25%" />
                    <span class="range-thumb" style="left:75%" />
                  </span>
                </div>
              )}
              {f.id === 'buffer' && (
                <div class="mini-timeline">
                  <span class="mt-track">
                    <span class="mt-past" />
                    <span class="mt-marker">
                      <span>Your buffer</span>
                    </span>
                  </span>
                  <span class="mt-ticks">
                    <span>0:00</span>
                    <span>3:00</span>
                  </span>
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/get-started?program=ppc" class="btn btn-primary" data-cta="pricing_card">
          Get your pay per call rate
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="#billing-title" class="btn btn-secondary">
          {' '}
          See how the buffer works{' '}
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="billing-title">
    <div class="container grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] lg:items-center">
      <div>
        <SectionHead
          eyebrow="How billing works"
          title="Short calls cost you nothing."
          lead="Your buffer is agreed before your first call."
          id="billing-title"
        />
        <div class="text-ink-2 mt-6 grid gap-4" data-reveal>
          <p>
            A call that ends inside your buffer is free. A call that passes it is billed once, from
            your prepaid balance.
          </p>
          <p>
            Your call log shows every call’s length and whether it was billable, so you never have
            to guess.
          </p>
        </div>
      </div>

      <div class="buffer" data-reveal data-buffer={BUFFER}>
        <h3>Drag to see what you’d pay for</h3>
        <p class="readout mt-3" aria-live="polite">
          <span data-readout>Call length: {fmt(START)}</span>
          <span class="status" data-status>
            Not billable
          </span>
        </p>
        <div class="timeline mt-10" style={`--v:${START / 180};--b:${BUFFER / 180}`}>
          <div class="track" aria-hidden="true">
            <span class="fill"></span>
            <span class="marker">
              <span>Your buffer</span>
            </span>
          </div>
          <label for="call-length" class="sr-only">
            {' '}
            Call length{' '}
          </label>
          <input
            id="call-length"
            type="range"
            min="0"
            max="180"
            step="5"
            value={START}
            aria-valuetext="1 minute 10 seconds, not billable"
            data-slider
          />
          <div class="ticks-row" aria-hidden="true">
            <span>0:00</span>
            <span>1:00</span>
            <span>2:00</span>
            <span>3:00</span>
          </div>
        </div>
        <p class="text-ink-3 mt-8 text-sm">Example only. Your buffer is set on your agreement.</p>
      </div>
    </div>
  </section>

  <QualificationSection />

  <section class="section bg-paper" aria-labelledby="ways-title">
    <div class="container">
      <SectionHead
        eyebrow="Taking calls"
        title="Use your phones, or ours."
        lead="Send calls to your existing phones or dialer, or let your agents take them in the portal. Either way, you get the full portal."
        id="ways-title"
      />
      <div class="lanes mt-12" data-reveal>
        <div class="caller">
          <span class="caller-icon">
            <Icon name="phone-incoming" size={26} />
          </span>
          <span class="caller-label">Caller</span>
        </div>
        <svg class="fork" viewBox="0 0 120 240" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 120 H40 C70 120 70 50 100 50 H116"></path>
          <path d="M40 120 C70 120 70 190 100 190 H116"></path>
          <path d="M108 42 116 50 108 58 M108 182 116 190 108 198"></path>
        </svg>
        <svg class="fork-v" viewBox="0 0 24 40" aria-hidden="true">
          <path d="M12 0 V36 M5 29 12 36 19 29"></path>
        </svg>
        <div class="lane-list">
          <article class="card card-pad card-interactive lane">
            <IconBadge name="phone-forwarded" />
            <div>
              <h3>Your phones or dialer</h3>
              <p class="text-ink-2 mt-2">
                We transfer every call to the number you give us. Keep your setup and still get the
                call log, recordings, spend and statements.
              </p>
            </div>
          </article>
          <article class="card card-pad card-interactive lane">
            <IconBadge name="headset" />
            <div>
              <h3>Your agents in the portal</h3>
              <p class="text-ink-2 mt-2">
                No phone system needed. Your agents answer in their browser, with a CRM and
                application logging built in.
              </p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section navy" aria-labelledby="returns-title">
    <div class="container">
      <SectionHead
        eyebrow="Returns"
        title="Bad call? Request a return."
        lead="If a call doesn’t meet the criteria on your agreement, request a return right from your call log within 30 days. Every request is reviewed and the decision shows in your portal."
        id="returns-title"
      />
      <div class="mt-12">
        <Flow
          dark
          items={[
            {
              title: 'Request from your call log',
              icon: 'undo-2',
              body: 'Pick the call and send the request.',
            },
            { title: 'Reviewed', icon: 'eye', body: 'Every request gets reviewed.' },
            {
              title: 'Decision shows in your portal',
              icon: 'check-circle',
              body: 'The decision appears next to the call.',
            },
          ]}
        />
      </div>
    </div>
  </section>

  <FaqStrip
    lead="Common questions about pay per call."
    items={[
      [
        'What’s the buffer?',
        'The number of seconds on your agreement a call has to pass before it’s billable. Anything shorter is free.',
      ],
      ['Can I pause calls?', 'Yes. Lower your daily cap or change your hours in the portal.'],
      ['How do I add funds?', 'Request a top-up from the billing page in your portal.'],
    ]}
  />

  <CtaBand />
</Base>

<style>
  .filter-card {
    display: flex;
    flex-direction: column;
  }
  .filter-visual {
    display: flex;
    align-items: center;
    min-height: 104px;
    margin-top: auto;
    padding: 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--rule);
    background: var(--grad-panel);
  }
  .filter-card p + .filter-visual {
    margin-top: 1.5rem;
  }
  .fchips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .fchip {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid #b7c2d2;
    background: #fff;
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .fchip.on {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .range {
    display: grid;
    gap: 0.875rem;
    width: 100%;
  }
  .range-label,
  .mt-ticks {
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-weight: 650;
  }
  .range-track,
  .mt-track {
    position: relative;
    height: 8px;
    border-radius: 999px;
    background: #dbe3ee;
  }
  .range-fill {
    position: absolute;
    inset: 0 25%;
    border-radius: inherit;
    background: var(--blue-strong);
  }
  .range-thumb {
    position: absolute;
    top: 50%;
    width: 22px;
    height: 22px;
    translate: -50% -50%;
    border-radius: 999px;
    background: #fff;
    border: 3px solid var(--navy);
    box-shadow: var(--shadow-card);
  }
  .mini-timeline {
    display: grid;
    gap: 0.625rem;
    width: 100%;
    padding-top: 1.5rem;
  }
  .mt-past {
    position: absolute;
    inset: 0 50% 0 0;
    border-radius: inherit;
    background: var(--ink-3);
  }
  .mt-marker {
    position: absolute;
    left: 50%;
    top: -8px;
    bottom: -8px;
    width: 2px;
    background: var(--navy);
  }
  .mt-marker span {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    translate: -50% 0;
    white-space: nowrap;
    color: var(--navy);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .mt-ticks {
    display: flex;
    justify-content: space-between;
  }

  .buffer {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: var(--radius-panel);
    border: 1px solid var(--rule);
    background: var(--grad-panel);
    box-shadow: var(--shadow-raised);
  }
  .readout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    color: var(--navy);
    font-size: 1.5rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .status {
    padding: 4px 12px;
    border-radius: 999px;
    background: #e6ebf2;
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 700;
  }
  .status.billable {
    background: var(--blue-strong);
    color: #fff;
  }
  .timeline {
    position: relative;
    padding-top: 1.75rem;
  }
  .track {
    position: relative;
    height: 10px;
    border-radius: 999px;
    background: #dbe3ee;
  }
  /* Grey up to the buffer, blue past it. */
  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--v) * 100%);
    border-radius: inherit;
    background: linear-gradient(
      to right,
      var(--ink-3) 0 calc(var(--b) / var(--v) * 100%),
      var(--blue-strong) 0
    );
  }
  .marker {
    position: absolute;
    left: calc(var(--b) * 100%);
    top: -10px;
    bottom: -10px;
    width: 2px;
    background: var(--navy);
  }
  .marker span {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    color: var(--navy);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  /* The native range sits on the track as its thumb. */
  input[type='range'] {
    position: absolute;
    left: -14px;
    right: -14px;
    top: calc(1.75rem - 17px);
    width: calc(100% + 28px);
    height: 44px;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track {
    height: 44px;
    background: transparent;
  }
  input[type='range']::-moz-range-track {
    background: transparent;
  }
  input[type='range']::-webkit-slider-thumb {
    appearance: none;
    width: 28px;
    height: 28px;
    margin-top: 8px;
    border-radius: 999px;
    background: #fff;
    border: 3px solid var(--navy);
    box-shadow: 0 4px 10px -2px rgba(11, 35, 80, 0.35);
  }
  input[type='range']::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: #fff;
    border: 3px solid var(--navy);
    box-shadow: 0 4px 10px -2px rgba(11, 35, 80, 0.35);
  }
  input[type='range']:focus-visible {
    outline: none;
  }
  input[type='range']:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--blue-strong);
    outline-offset: 2px;
  }
  input[type='range']:focus-visible::-moz-range-thumb {
    outline: 2px solid var(--blue-strong);
    outline-offset: 2px;
  }
  .ticks-row {
    display: flex;
    justify-content: space-between;
    margin-top: 1.25rem;
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .lanes {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }
  .caller {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
  }
  .caller-icon {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 999px;
    background: var(--navy);
    color: #fff;
    box-shadow: 0 0 0 8px var(--blue-glow);
  }
  .caller-label {
    color: var(--navy);
    font-weight: 700;
  }
  .fork,
  .fork-v {
    fill: none;
    stroke: var(--blue-strong);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fork {
    display: none;
  }
  .fork-v {
    width: 24px;
    height: 40px;
  }
  .lane-list {
    display: grid;
    gap: 1.25rem;
    width: 100%;
  }
  .lane {
    display: flex;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .lanes {
      grid-template-columns: auto 120px minmax(0, 1fr);
      align-items: center;
      gap: 0;
    }
    .fork {
      display: block;
      width: 120px;
      height: 100%;
      min-height: 240px;
    }
    .fork path {
      vector-effect: non-scaling-stroke;
    }
    .fork-v {
      display: none;
    }
  }
</style>

<script>
  import { track } from '../lib/track';

  const card = document.querySelector<HTMLElement>('[data-buffer]')!;
  const buffer = Number(card.dataset.buffer);
  const slider = card.querySelector<HTMLInputElement>('[data-slider]')!;
  const readout = card.querySelector<HTMLElement>('[data-readout]')!;
  const status = card.querySelector<HTMLElement>('[data-status]')!;
  const timeline = card.querySelector<HTMLElement>('.timeline')!;
  const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;

  const update = () => {
    const v = Number(slider.value);
    const billable = v > buffer;
    const m = Math.floor(v / 60);
    const s = v % 60;
    const label = billable ? 'Billable' : 'Not billable';
    readout.textContent = `Call length: ${m}:${String(s).padStart(2, '0')}`;
    status.textContent = label;
    status.classList.toggle('billable', billable);
    const spoken = [m && plural(m, 'minute'), (s || !m) && plural(s, 'second')]
      .filter(Boolean)
      .join(' ');
    slider.setAttribute('aria-valuetext', `${spoken}, ${label.toLowerCase()}`);
    timeline.style.setProperty('--v', String(Math.max(v, 0.001) / 180));
  };
  slider.addEventListener('input', update);
  slider.addEventListener('input', () => track('buffer_slider_used'), { once: true });
  update();
</script>
