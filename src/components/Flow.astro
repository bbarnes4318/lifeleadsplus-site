---
import IconBadge from './IconBadge.astro';
import type { IconName } from './Icon.astro';

interface Props {
  items: { title: string; body?: string; icon: IconName; price?: string }[];
  /** On a navy band. */
  dark?: boolean;
}
const { items, dark = false } = Astro.props;
---

<ol class:list={['flow', { 'flow-dark': dark }]} style={`--n:${items.length}`} data-reveal-group>
  {items.map((item, i) => (
    <li class="card card-pad card-interactive flow-card" data-reveal>
      <div class="flow-top">
        <span class="flow-num" aria-hidden="true">
          {i + 1}
        </span>
        <IconBadge name={item.icon} dark={dark} />
      </div>
      <h3 class="mt-5">
        <span class="sr-only">Step {i + 1}: </span>
        {item.title}
      </h3>
      {item.price && <p class="flow-price">{item.price}</p>}
      {item.body && <p class="flow-body">{item.body}</p>}
    </li>
  ))}
</ol>

<style>
  .flow {
    position: relative;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .flow {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: 1.5rem;
    }
    /* Dashed line through the step numbers, behind the cards. */
    .flow::before {
      content: '';
      position: absolute;
      top: 52px;
      left: calc(100% / var(--n) / 2);
      right: calc(100% / var(--n) / 2);
      border-top: 2px dashed var(--blue);
      opacity: 0.5;
    }
  }
  .flow-card {
    position: relative;
  }
  .flow-price {
    margin-top: 0.5rem;
    font-size: 1.25rem;
    font-weight: 750;
    color: var(--navy);
  }
  .flow-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .flow-num {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--navy);
    color: #fff;
    font-weight: 750;
    box-shadow: 0 0 0 6px var(--surface);
  }
  .flow-body {
    margin-top: 0.5rem;
    color: var(--ink-2);
  }
  .flow-dark .flow-num {
    background: #fff;
    color: var(--navy);
    box-shadow: none;
  }
  .flow-dark .flow-body {
    color: var(--on-navy);
  }
  .flow-dark::before {
    border-color: var(--on-navy-accent);
  }
  /* Opaque navy behind the glassy cards so the dashed line doesn't show through. */
  .flow-dark .flow-card {
    background:
      linear-gradient(rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.05)), var(--navy-2);
  }
</style>
