---
import { Picture } from 'astro:assets';
import floorCards from '../assets/screens/floor-cards.png';
import applications from '../assets/screens/applications.png';
import customers from '../assets/screens/customers.png';
import statements from '../assets/screens/statements.png';

// The only portal screenshots on the site: crops with no sidebar, header or toasts.
// Regenerate with `node scripts/crop-screens.mjs`.
// WebP is listed first: for these text-heavy UI crops AVIF comes out 30–40% larger.
const shots = {
  'floor-cards': floorCards,
  applications,
  customers,
  statements,
};

interface Props {
  shot: keyof typeof shots;
  alt: string;
  class?: string;
  eager?: boolean;
}
const { shot, alt, class: className, eager = false } = Astro.props;
const src = shots[shot];
---

<div class:list={['panel', className]} style={`width:${src.width}px`}>
  <Picture
    src={src}
    alt={alt}
    formats={['webp', 'avif']}
    width={src.width}
    height={src.height}
    widths={[Math.round(src.width / 2), src.width]}
    sizes={`(min-width: ${src.width + 48}px) ${src.width}px, calc(100vw - 32px)`}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    quality={85}
  />
</div>
