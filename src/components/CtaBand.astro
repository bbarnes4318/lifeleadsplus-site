---
import Icon from './Icon.astro';
import { loginHref, phone, telHref } from '../lib/site';

interface Props {
  /** Background of the section around the panel; pick the one that differs from the section above. */
  bg?: 'white' | 'paper';
  eyebrow?: string;
  title?: string;
  lead?: string;
  cta?: string;
  /** Adds "Already have an account? Sign In" under the buttons. */
  signIn?: boolean;
}
const {
  bg = 'white',
  eyebrow = 'Next step',
  title = 'Put live callers in front of your agents.',
  lead = 'Tell us your states, agent count and volume. We’ll send your program, your rate and your agreement.',
  cta = 'Get your rate',
  signIn = false,
} = Astro.props;
---

<section class:list={['section', { 'bg-paper': bg === 'paper' }]} aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-panel navy" data-reveal>
      <div class="section-head">
        <p class="pill">{eyebrow}</p>
        <h2 id="cta-title">{title}</h2>
        <p class="lead">{lead}</p>
      </div>
      <div class="cta-actions">
        <a href="/get-started" class="btn btn-light" data-cta="cta_band">
          {cta}
          <Icon name="arrow-right" size={18} />
        </a>
        {phone && (
          <a href={telHref} class="btn btn-ghost">
            <Icon name="phone" size={18} />
            Call {phone}
          </a>
        )}
        {signIn && (
          <p class="text-[0.9375rem]">
            Already have an account?{' '}
            <a href={loginHref} class="font-semibold">
              Sign In
            </a>
          </p>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-panel {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2.5rem, 6vw, 4.5rem);
    border-radius: var(--radius-panel);
    border-top: 3px solid var(--red);
    box-shadow: var(--shadow-raised);
    overflow: hidden;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (min-width: 1024px) {
    .cta-panel {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
