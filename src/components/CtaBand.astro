---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  sub?: string;
}
const {
  title = 'Ready for live calls?',
  sub = "Tell us about your agency and we'll set up your program.",
} = Astro.props;
---

<section class="cta-band navy glow" aria-labelledby="cta-title">
  <div
    class="container flex flex-col items-start gap-6 py-16 md:flex-row md:items-center md:justify-between md:py-20"
    data-reveal
  >
    <div>
      <h2 id="cta-title">{title}</h2>
      <p class="mt-3 text-lg">{sub}</p>
    </div>
    <a href="/get-started" class="btn btn-primary shrink-0">
      Get started
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</section>

<style>
  .cta-band {
    border-top: 3px solid var(--red);
  }
</style>
