---
import Icon from './Icon.astro';
import { phone, telHref } from '../lib/site';

interface Props {
  /** Background of the section around the panel; pick the one that differs from the section above. */
  bg?: 'white' | 'paper';
}
const { bg = 'white' } = Astro.props;
---

<section class:list={['section', { 'bg-paper': bg === 'paper' }]} aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-panel navy" data-reveal>
      <div class="section-head">
        <p class="pill">Get started</p>
        <h2 id="cta-title">Ready to stop paying for calls that go nowhere?</h2>
        <p class="lead">
          Tell us your target states, team size and daily volume. We’ll send your custom rate and
          your agreement.
        </p>
      </div>
      <div class="cta-actions">
        <a href="/get-started" class="btn btn-light" data-cta="cta_band">
          Get My Rate Now
          <Icon name="arrow-right" size={18} />
        </a>
        {phone && (
          <a href={telHref} class="btn btn-ghost">
            <Icon name="phone" size={18} />
            Call {phone}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-panel {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2.5rem, 6vw, 4.5rem);
    border-radius: var(--radius-panel);
    border-top: 3px solid var(--red);
    box-shadow: var(--shadow-raised);
    overflow: hidden;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (min-width: 1024px) {
    .cta-panel {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
