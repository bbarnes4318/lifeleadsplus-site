---
import Icon from './Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  /** Primary button target, e.g. /get-started?program=ppa. */
  cta?: string;
  ctaLabel?: string;
  secondary?: { label: string; href: string };
}
const {
  eyebrow,
  title,
  intro,
  cta = '/get-started',
  ctaLabel = 'Get your rate',
  secondary,
} = Astro.props;
const hasAside = Astro.slots.has('aside');
const ctaAttr = (href: string) => (href.startsWith('/get-started') ? 'hero' : undefined);
---

<!-- Navy intro for every inner page; pair with <Base dark>. -->
<section class="intro navy">
  <div class:list={['container intro-inner', { 'has-aside': hasAside }]}>
    <div>
      {eyebrow && <p class="pill mb-5">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lead mt-5">{intro}</p>
      <slot />
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={cta} class="btn btn-primary" data-cta={ctaAttr(cta)}>
          {ctaLabel}
          <Icon name="arrow-right" size={18} />
        </a>
        {secondary && (
          <a href={secondary.href} class="btn btn-secondary" data-cta={ctaAttr(secondary.href)}>
            {secondary.label}
          </a>
        )}
      </div>
    </div>
    {hasAside && (
      <div class="intro-aside">
        <slot name="aside" />
      </div>
    )}
  </div>
</section>

<style>
  .intro {
    display: flex;
    align-items: center;
    min-height: 44vh;
    padding-top: var(--header-h);
    border-bottom: 3px solid var(--red);
  }
  .intro-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-block: 3.5rem 4rem;
  }
  h1 {
    max-width: 18ch;
  }
  .lead {
    max-width: 56ch;
  }
  @media (min-width: 1024px) {
    .intro-inner.has-aside {
      grid-template-columns: minmax(0, 1fr) 420px;
      align-items: center;
      gap: 4rem;
    }
  }
</style>
