---
interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  /** Compact navy hero (pair with <Base dark>). */
  dark?: boolean;
}
const { eyebrow, title, intro, dark = false } = Astro.props;
---

<section class:list={dark ? 'intro-dark navy glow' : 'bg-paper border-rule border-b'}>
  <div class:list={['container', dark ? 'intro-dark-inner' : 'py-14 md:py-20']}>
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h1 class="max-w-[20ch]">{title}</h1>
    <p class="lead mt-5">{intro}</p>
    <slot />
  </div>
</section>

<style>
  .intro-dark {
    display: flex;
    align-items: center;
    min-height: 48vh;
    padding-top: var(--header-h);
  }
  .intro-dark-inner {
    padding-block: 3.5rem 4rem;
  }
</style>
