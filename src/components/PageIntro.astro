---
interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="bg-paper border-rule border-b">
  <div class="container py-14 md:py-20">
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h1 class="max-w-[20ch]">{title}</h1>
    <p class="lead mt-5">{intro}</p>
    <slot />
  </div>
</section>
