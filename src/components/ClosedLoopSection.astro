---
import SectionHead from './SectionHead.astro';
import IconBadge from './IconBadge.astro';

const usual = ['Call center', 'Lead network', 'Dialer vendor', 'CRM vendor', 'Your agent'];
const ours = ['Caller', 'One closed system', 'Your agent'];
const cards = [
  [
    'shield-check',
    'No outside vendors in the middle',
    'Screening, routing and transfer happen in one system, with no handoff to another company.',
  ],
  [
    'users',
    'Your data stays in one place',
    'Callers, recordings and applications live in your portal, not scattered across vendors you’ve never met.',
  ],
  [
    'file-text',
    'One record for every call',
    'Recording, length, screening and outcome sit in one call log, so proof is a click away.',
  ],
  [
    'phone-forwarded',
    'One team to call',
    'If a call isn’t right, one team fixes it. No chain of vendors pointing at each other.',
  ],
] as const;
---

<section class="section navy" aria-labelledby="closed-title">
  <div class="container">
    <SectionHead
      eyebrow="One closed system"
      title="No middlemen between the caller and your agent."
      lead="Most vendors pass your caller through other companies’ phone lines, dialers, CRMs and call centers. Every handoff is another company with your callers and your data. We run it in one system, from the first ring to your agent’s screen."
      id="closed-title"
    />

    <div class="compare mt-12" data-reveal>
      <div class="panel">
        <p class="panel-label">The usual chain</p>
        <ol class="chain">
          {usual.map((c) => (
            <li>{c}</li>
          ))}
        </ol>
        <p class="panel-caption">
          Every link is another company with access to your callers and data.
        </p>
      </div>
      <div class="panel ours">
        <p class="panel-label">Life Leads Plus</p>
        <ol class="chain">
          {ours.map((c) => (
            <li>{c}</li>
          ))}
        </ol>
        <p class="panel-caption">
          Screening, routing, transfer, recording and your portal, all in one place.
        </p>
      </div>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {cards.map(([icon, title, body]) => (
        <li class="card card-pad" data-reveal>
          <IconBadge name={icon} dark />
          <h3 class="mt-5 text-[1.1875rem]">{title}</h3>
          <p class="mt-2">{body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .compare {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .compare {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .panel {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-card);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
  }
  .panel.ours {
    border-color: rgba(140, 200, 255, 0.35);
    background: rgba(0, 129, 241, 0.12);
  }
  .panel-label {
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.625rem;
    margin-top: 1.25rem;
  }
  .chain li {
    display: flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.05);
    color: var(--on-navy);
    font-size: 0.875rem;
    font-weight: 650;
    white-space: nowrap;
  }
  /* Connector drawn before every chip but the first. */
  .chain li + li {
    margin-left: 1.5rem;
    position: relative;
  }
  .chain li + li::before {
    content: '';
    position: absolute;
    right: calc(100% + 1px);
    top: 50%;
    width: 1.5rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.35);
  }
  .ours .chain li {
    border-color: rgba(140, 200, 255, 0.45);
    background: rgba(0, 129, 241, 0.18);
    color: #fff;
  }
  .ours .chain li + li::before {
    border-top: 2px solid var(--blue);
  }
  .panel-caption {
    margin-top: 1.25rem;
    color: var(--on-navy);
    font-size: 0.9375rem;
  }
</style>
