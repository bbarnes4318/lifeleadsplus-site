---
import { getImage } from 'astro:assets';
import buyerBilling from '../assets/screens/buyer-billing-1440.png';
import agentsFloor from '../assets/screens/agents-floor-1440.png';
import agentsFloorMobile from '../assets/screens/agents-floor-390.png';
import crmAgent from '../assets/screens/crm-agent-1440.png';
import applications from '../assets/screens/applications-1440.png';

const shots = {
  'buyer-billing': buyerBilling,
  'agents-floor': agentsFloor,
  'crm-agent': crmAgent,
  applications,
};

interface Props {
  shot: keyof typeof shots;
  alt: string;
  sizes: string;
  /** Hero: eager, high priority, and the 390px screenshot below 900px. */
  hero?: boolean;
  class?: string;
}
const { shot, alt, sizes, hero = false, class: className } = Astro.props;
const src = shots[shot];
const img = await getImage({ src, widths: [640, 1280], format: 'webp', quality: 82 });
const mobile = hero
  ? await getImage({ src: agentsFloorMobile, format: 'webp', quality: 82 })
  : null;
---

<figure class:list={['frame', { 'frame-hero': hero }, className]}>
  <div class="frame-bar" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <picture>
    {mobile && <source media="(max-width: 899px)" srcset={mobile.src} width={390} height={640} />}
    <img
      src={img.src}
      srcset={img.srcSet.attribute}
      sizes={sizes}
      alt={alt}
      width={src.width}
      height={src.height}
      loading={hero ? 'eager' : 'lazy'}
      decoding={hero ? 'sync' : 'async'}
      fetchpriority={hero ? 'high' : 'auto'}
    />
  </picture>
</figure>

<style>
  .frame {
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: var(--shadow-raised);
    overflow: hidden;
  }
  .frame-bar {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .frame-bar span {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: #cbd3de;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 899px) {
    .frame-hero {
      max-width: 390px;
      margin-inline: auto;
    }
    .frame-hero img {
      aspect-ratio: 390 / 640;
      object-fit: cover;
      object-position: top;
    }
  }
</style>
