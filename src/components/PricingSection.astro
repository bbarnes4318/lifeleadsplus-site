---
import SectionHead from './SectionHead.astro';
import IconBadge from './IconBadge.astro';
import PriceTag from './PriceTag.astro';
import CheckList from './CheckList.astro';
import Icon from './Icon.astro';
import { pricing, ppcFilters } from '../lib/offer';

interface Props {
  bg?: 'white' | 'paper';
}
const { bg = 'paper' } = Astro.props;
const cards = [
  { id: 'ppa', icon: 'receipt', pill: 'No application, no charge', ...pricing.ppa },
  { id: 'ppc', icon: 'phone-forwarded', pill: 'Short calls are free', ...pricing.ppc },
] as const;
---

<section
  class:list={['section', { 'bg-paper': bg === 'paper' }]}
  aria-labelledby="pricing-title"
  id="pricing"
>
  <div class="container">
    <SectionHead
      eyebrow="Pricing"
      title="Pay per application or pay per call."
      lead="Pay per application: you’re charged only when an agent submits one. Pay per call: calls that end inside your buffer are free. Both are prepaid, with no surprise invoices."
      id="pricing-title"
    />
    <div class="mt-12 grid gap-6 lg:grid-cols-2" data-reveal-group>
      {cards.map((c) => (
        <article
          class:list={['card card-pad plan', { featured: c.id === 'ppa' }]}
          aria-labelledby={`plan-${c.id}`}
          data-reveal
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <IconBadge name={c.icon} />
            <span class="plan-pill">{c.pill}</span>
          </div>
          <h3 id={`plan-${c.id}`} class="mt-5 text-[1.625rem]">
            {c.name}
          </h3>
          <ul class="price-rows">
            {c.rows.map((r) => (
              <li>
                <span class="price-vertical">{r.vertical}</span>
                <PriceTag amount={r.from} unit={c.unit} class="text-right" />
              </li>
            ))}
          </ul>
          {c.id === 'ppc' && (
            <div class="depends">
              <span class="depends-label">Price depends on:</span>
              <span class="depends-pills">
                {ppcFilters.map((f, i) => (
                  <>
                    {i > 0 && <span>{' · '}</span>}
                    <span class="depends-pill">{f.title}</span>
                  </>
                ))}
              </span>
            </div>
          )}
          <p class="plan-note">{c.note}</p>
          <CheckList items={c.bullets} class="mt-6" />
          <div class="plan-actions">
            <a href={c.apply} class="btn btn-primary" data-cta="pricing_card">
              Get your {c.name.toLowerCase()} rate
              <Icon name="arrow-right" size={18} />
            </a>
            <a href={c.href} class="btn btn-secondary">
              How it works<span class="sr-only"> for {c.name.toLowerCase()}</span>
            </a>
          </div>
        </article>
      ))}
    </div>
    <p class="text-ink-2 mt-8 text-[0.9375rem]">
      Not sure which fits? Choose ‘Not sure yet’ on the <a href="/get-started">application</a> and
      we’ll recommend one.
    </p>
  </div>
</section>

<style>
  .plan {
    display: flex;
    flex-direction: column;
  }
  .featured {
    border-top: 2px solid var(--blue-strong);
  }
  .plan-pill {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 650;
  }
  .featured .plan-pill {
    background: var(--blue-tint);
    border-color: transparent;
    color: var(--blue-strong);
  }
  .price-rows {
    margin-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .price-rows li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .price-vertical {
    color: var(--navy);
    font-weight: 700;
  }
  .price-rows :global(.price-line) {
    justify-content: flex-end;
  }
  .depends {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 1rem;
  }
  .depends-label {
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .depends-pills {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    color: var(--ink-3);
  }
  .depends-pill {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--blue-tint);
    color: var(--blue-strong);
    font-size: 0.875rem;
    font-weight: 650;
  }
  .plan-note {
    margin-top: 1rem;
    color: var(--ink-3);
    font-size: 0.9375rem;
  }
  .plan-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 2rem;
  }
  @media (max-width: 479px) {
    .plan-actions .btn {
      width: 100%;
      white-space: normal;
    }
  }
</style>
