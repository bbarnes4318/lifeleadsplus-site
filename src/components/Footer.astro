---
import { Image } from 'astro:assets';
import wordmarkOnDark from '../assets/brand/logo-on-dark.png';
import Icon from './Icon.astro';
import { loginHref, phone, telHref, email, legalName } from '../lib/site';

const columns = [
  {
    title: 'Programs',
    links: [
      { href: '/pay-per-application', label: 'Pay Per Application' },
      { href: '/pay-per-call', label: 'Pay Per Call' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/platform', label: 'Agency Dashboard' },
      { href: '/faq', label: 'FAQ' },
      { href: '/get-started', label: 'Get your rate' },
      { href: loginHref, label: 'Client login' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/terms', label: 'Terms of Service' },
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/tcpa-compliance', label: 'TCPA & Compliance' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container py-14">
    <div class="footer-top">
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="/" aria-label="Life Leads Plus home" class="inline-block">
          <Image
            src={wordmarkOnDark}
            alt="Life Leads Plus"
            height={56}
            densities={[1, 2]}
            class="h-14 w-auto"
          />
        </a>
        <p class="max-w-[40ch] text-[0.9375rem]">
          Live, screened Final Expense and Medicare calls for licensed agents and agencies.
        </p>
      </div>
      <a href="/get-started" class="btn btn-light" data-cta="footer">
        Get your rate
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
    <div class="grid gap-10 pt-10 md:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div>
        <h2 class="footer-title">Contact</h2>
        {phone || email ? (
          <ul class="mt-3 grid gap-1.5 text-[0.9375rem]">
            {phone && (
              <li>
                <a href={telHref} class="flex items-center gap-2">
                  <Icon name="phone" size={16} class="text-blue" />
                  {phone}
                </a>
              </li>
            )}
            {email && (
              <li>
                <a href={`mailto:${email}`} class="flex items-center gap-2">
                  <Icon name="mail" size={16} class="text-blue" />
                  {email}
                </a>
              </li>
            )}
          </ul>
        ) : (
          <p class="mt-3 text-[0.9375rem]">
            <a href="/get-started">Get your custom rate</a>
          </p>
        )}
      </div>
      {columns.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="footer-title">{col.title}</h2>
          <ul class="mt-3 grid gap-1.5 text-[0.9375rem]">
            {col.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <p class="mt-12 max-w-none border-t border-white/10 pt-6 text-sm">
      © {new Date().getFullYear()}
      {legalName}. All rights reserved.
      <span class="legal-links">
        · <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> ·
        <a href="/tcpa-compliance">TCPA &amp; Compliance</a>
      </span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-3);
    color: #c8d3e6;
  }
  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .footer-top .btn {
    color: var(--navy);
    text-decoration: none;
  }
  .footer-title {
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  a {
    color: #e6ecf6;
    text-decoration: none;
  }
  p a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  p .legal-links a {
    color: inherit;
    text-decoration: none;
  }
  p .legal-links a:hover {
    text-decoration: underline;
  }
  a:focus-visible {
    outline-color: #fff;
  }
</style>
