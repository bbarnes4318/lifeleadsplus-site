---
import SectionHead from './SectionHead.astro';
import IconBadge from './IconBadge.astro';
import Icon from './Icon.astro';

interface Props {
  items: [string, string][];
  lead?: string;
}
const { items, lead = 'Quick answers before you start.' } = Astro.props;
---

<section class="section bg-paper" aria-labelledby="faq-strip-title">
  <div class="container">
    <SectionHead
      eyebrow="FAQ"
      title="FAQ"
      id="faq-strip-title"
      lead={lead}
    />
    <div class="mt-12 grid gap-5 md:grid-cols-3" data-reveal-group>
      {items.map(([q, a]) => (
        <div class="card card-pad" data-reveal>
          <IconBadge name="circle-help" />
          <h3 class="mt-5 text-[1.1875rem]">{q}</h3>
          <p class="text-ink-2 mt-2">{a}</p>
        </div>
      ))}
    </div>
    <a href="/faq" class="link-arrow mt-10">
      All questions
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</section>
