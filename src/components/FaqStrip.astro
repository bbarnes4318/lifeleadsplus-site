---
interface Props {
  items: [string, string][];
}
const { items } = Astro.props;
---

<section class="section bg-paper" aria-labelledby="faq-strip-title">
  <div class="container">
    <h2 id="faq-strip-title">Questions</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {items.map(([q, a]) => (
        <div class="card p-6">
          <h3 class="text-lg">{q}</h3>
          <p class="text-ink-2 mt-2">{a}</p>
        </div>
      ))}
    </div>
    <a href="/faq" class="link-arrow mt-8">
      All questions
    </a>
  </div>
</section>
