---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { qualifications } from '../lib/offer';

interface Props {
  defaultTab?: keyof typeof qualifications;
  bg?: 'white' | 'paper';
}
const { defaultTab = 'final-expense', bg = 'white' } = Astro.props;
const verticals = Object.entries(qualifications) as [
  keyof typeof qualifications,
  (typeof qualifications)[keyof typeof qualifications],
][];
const facts = [
  ['map-pin', 'Only from your licensed states'],
  ['calendar-clock', 'Only during your delivery hours'],
  ['phone-forwarded', 'Live transfers, not lead lists'],
] as const;
---

<section class:list={['section', { 'bg-paper': bg === 'paper' }]} aria-labelledby="qual-title">
  <div class="container">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHead
        eyebrow="Quality control"
        title="Every caller passes a 6-point quality gate."
        lead="Your agents sell to decision-makers, not tire-kickers. Anyone who doesn’t qualify never reaches them."
        id="qual-title"
      />
      <div class="segmented" role="tablist" aria-label="Verticals" data-qual-tabs>
        {verticals.map(([id, v]) => (
          <button
            type="button"
            role="tab"
            id={`qtab-${id}`}
            aria-controls={`qpanel-${id}`}
            aria-selected={id === defaultTab ? 'true' : 'false'}
            tabindex={id === defaultTab ? 0 : -1}
            data-vertical={id}
          >
            {v.label}
          </button>
        ))}
      </div>
    </div>

    {verticals.map(([id, v]) => (
      <div
        class="qual-panel"
        role="tabpanel"
        id={`qpanel-${id}`}
        aria-labelledby={`qtab-${id}`}
        hidden={id !== defaultTab}
      >
        <div class="card card-pad">
          <ol class="qual-list" aria-label={`${v.label} qualification questions`}>
            {v.items.map((item, i) => (
              <li>
                <span class="num-circle" aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <p class="qual-title">{item.title}</p>
                  <p class="qual-body">{item.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="transfer" aria-hidden="true" data-transfer>
          <div class="call">
            <div class="call-head">
              <span class="call-avatar">
                <Icon name="phone-incoming" size={20} />
              </span>
              <div>
                <p class="call-kicker">Incoming transfer · {v.label}</p>
                <p class="call-sub">Screening the caller</p>
              </div>
              <span class="call-live">Live</span>
            </div>
            <ul class="chips">
              {v.items.map((item, i) => (
                <li class="chip" style={`--d:${i}`}>
                  <Icon name="check" size={14} />
                  {item.title}
                </li>
              ))}
            </ul>
            <p class="done" style={`--d:${v.items.length}`}>
              <Icon name="phone-forwarded" size={16} />
              Transferred to your agent
            </p>
          </div>
        </div>
      </div>
    ))}

    <ul class="facts">
      {facts.map(([icon, text]) => (
        <li>
          <Icon name={icon} size={18} />
          {text}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .qual-panel {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
  }
  @media (min-width: 1024px) {
    .qual-panel:not([hidden]) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: stretch;
    }
  }
  .qual-list li {
    display: flex;
    gap: 1rem;
    padding-block: 1.125rem;
    border-top: 1px solid var(--rule);
  }
  .qual-list li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .qual-list li:last-child {
    padding-bottom: 0;
  }
  .qual-title {
    color: var(--navy);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .qual-body {
    margin-top: 0.25rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .transfer {
    display: grid;
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-panel);
    border: 1px solid var(--rule);
    background: var(--grad-panel);
  }
  .call {
    padding: 1.25rem;
    border-radius: var(--radius-card);
    background: #fff;
    box-shadow: var(--shadow-raised);
  }
  .call-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .call-avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--navy);
    color: #fff;
  }
  .call-kicker {
    color: var(--navy);
    font-weight: 700;
    line-height: 1.3;
  }
  .call-sub {
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  .call-live {
    margin-left: auto;
    padding: 2px 10px;
    border-radius: 999px;
    background: #fdecec;
    color: #b00000;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .chips {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    background: #ecfdf3;
    color: #05603a;
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1.3;
  }
  .chip :global(svg) {
    flex-shrink: 0;
    padding: 2px;
    border-radius: 999px;
    background: #12b76a;
    color: #fff;
    stroke-width: 3;
  }
  .done {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.625rem 1rem;
    border-radius: 999px;
    background: var(--blue-strong);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 700;
  }
  /* Chips land one by one once the card is in view, and again on each tab switch. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .transfer :is(.chip, .done) {
      opacity: 0;
      transform: translateY(6px);
    }
    :global(.js) .transfer.play :is(.chip, .done) {
      animation: chip-in 320ms var(--ease) both;
      animation-delay: calc(var(--d) * 120ms + 150ms);
    }
  }
  @keyframes chip-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 2rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .facts :global(svg) {
    color: var(--blue-strong);
  }
</style>

<script>
  import { initTabs } from '../lib/tabs';
  import { track } from '../lib/track';

  const list = document.querySelector<HTMLElement>('[data-qual-tabs]');
  if (list) {
    const play = (el: HTMLElement) => {
      el.classList.remove('play');
      void el.offsetWidth; // restart the animation
      el.classList.add('play');
    };
    const seen = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          play(e.target as HTMLElement);
          seen.unobserve(e.target);
        }),
      { threshold: 0.3 },
    );
    document.querySelectorAll<HTMLElement>('[data-transfer]').forEach((t) => seen.observe(t));
    const tabs = [...list.querySelectorAll<HTMLElement>('[role=tab]')];
    initTabs(list, (i) => {
      const panel = document.getElementById(tabs[i].getAttribute('aria-controls')!)!;
      play(panel.querySelector<HTMLElement>('[data-transfer]')!);
      track('qualification_tab', { vertical: tabs[i].dataset.vertical });
    });
  }
</script>
