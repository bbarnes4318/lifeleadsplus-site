# Copy to .env for local development. Never commit .env.
# On Vercel, set these in Project Settings → Environment Variables (Production and Preview).

# Optional. Canonical origin for canonical URLs, sitemap, OG image and email logo.
# On Vercel, defaults to the project's production domain (custom domain, else *.vercel.app).
SITE_URL=

# Client portal origin; "Client login" goes to PORTAL_URL/login
PORTAL_URL=https://portal.example.com

# Where Get Started applications are emailed
APPLY_TO_EMAIL=applications@example.com

# SMTP for application + confirmation emails (port 465 uses TLS, others STARTTLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Life Leads Plus <no-reply@example.com>"

# Optional: shown in header, footer and Get Started when set; hidden everywhere when empty
PUBLIC_PHONE=
PUBLIC_EMAIL=

# Footer copyright and Privacy page (default "Life Leads Plus")
COMPANY_LEGAL_NAME=Life Leads Plus

# Optional: link for the "Schedule a call" button on the application success screen
PUBLIC_SCHEDULE_URL=

# Optional: every application and partial (step 1) lead is also POSTed here as JSON
# ({type: 'application' | 'partial', ...fields, submittedAt}). With this set, an application is
# accepted if either the webhook or the notification email succeeds.
APPLY_WEBHOOK_URL=

# Optional analytics. Each script loads only when its ID is set; with all empty, nothing loads
# and the Privacy page says the site uses no analytics.
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
# Google Ads: both are needed to send the lead conversion (send_to = ID/LABEL)
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
